<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lagwise-Setup</AssemblyName>
    <RootNamespace>Lagwise.Installer</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Lagwise Installer</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- shared with the app: how to reach a running Lagwise, and its startup entry -->
  <ItemGroup>
    <Compile Include="..\Lagwise.Core\AppInstance.cs" Link="Shared\AppInstance.cs" />
    <Compile Include="..\Lagwise.Core\Services\WindowsIntegrationService.cs" Link="Shared\WindowsIntegrationService.cs" />
  </ItemGroup>

</Project>
