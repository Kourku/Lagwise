<Window x:Class="NetPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetPulse.App.ViewModels"
        xmlns:controls="clr-namespace:NetPulse.App.Controls"
        xmlns:local="clr-namespace:NetPulse.App"
        mc:Ignorable="d"
        Title="NetPulse"
        Height="860" Width="1320" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- One integrated title bar instead of the Windows caption plus a second app bar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:UtcToLocalTimeConverter x:Key="LocalTime" />
        <local:EventLabelConverter x:Key="EventLabel" />
        <local:SeverityLabelConverter x:Key="SeverityLabel" />
        <local:SeverityBrushConverter x:Key="SeverityBrush" />
        <local:StringEqualsConverter x:Key="EqualsParam" />
        <local:ZeroToVisibleConverter x:Key="ZeroToVis" />
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>

        <!-- One step of the "what NetPulse measures" chain on the Overview -->
        <Style x:Key="ChainNodeIcon" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="Background" Value="{DynamicResource BlueSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BlueEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChainConnector" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,22,0,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ==================================================== -->
        <!-- Title bar (drag area, connection, mode, window buttons) -->
        <!-- ==================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource BrandGradientBrush}">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="14" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NetPulse" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Active connection -->
                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="32,0,0,0" Background="{DynamicResource BgCardBrush}" CornerRadius="15" Padding="12,5"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="The network adapter Windows is using now, and your router's address">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ActiveNic.Name, FallbackValue='Detecting...'}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding ActiveNic.SpeedDisplay, FallbackValue='', StringFormat='  ·  {0}'}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <TextBlock Text="  ·  Router " FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding ActiveNic.Ipv4Gateway, FallbackValue='searching'}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AccentBlueHoverBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <!-- Detail level + report -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Background="{DynamicResource BgInputBrush}" CornerRadius="9" Padding="3" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Beginner" ToolTip="Plain-language summaries and recommendations" Command="{Binding SetModeCommand}" CommandParameter="Beginner" Padding="12,4" FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBeginnerMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Advanced" ToolTip="Full statistics, protocols, routes and diagnostic evidence" Command="{Binding SetModeCommand}" CommandParameter="Advanced" Padding="12,4" FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBeginnerMode}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleOverlayCommand}" Padding="8,4" MinHeight="32" Margin="0,0,2,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Mini overlay" ToolTip="Show or hide the mini overlay: live ping on top of other windows (works over games in windowed or borderless mode)">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Appearance.ToggleThemeCommand}" Padding="8,4" MinHeight="32" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Switch theme" ToolTip="{Binding Appearance.ToggleTip}">
                        <TextBlock Text="{Binding Appearance.ToggleGlyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding ExportReportCommand}" Padding="12,4" MinHeight="32" FontSize="12.5"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Export diagnostic report" ToolTip="Save a readable report of the current state (Markdown)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Export report" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Window buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" Height="47" Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimise" ToolTip="Minimise" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Height="47" Click="MaximizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximise" ToolTip="Maximise" />
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Height="47" Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== -->
        <!-- Main Content Area with Navigation Sidebar -->
        <!-- ==================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16,12,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0,8,10" />
                        <RadioButton Content="Settings" Tag="&#xE713;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Settings}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Settings" />
                        <RadioButton Content="Help &amp; glossary" Tag="&#xE897;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Help}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Help" />
                        <TextBlock Text="{Binding AppVersionText}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,10,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <TextBlock Text="MONITOR" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,4,0,6" />
                        <RadioButton Content="Overview" Tag="&#xE80F;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Dashboard}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Dashboard" />
                        <Grid>
                            <RadioButton Content="Game Monitor" Tag="&#xE7FC;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                         IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=GameMonitor}"
                                         Command="{Binding SwitchTabCommand}" CommandParameter="GameMonitor" />
                            <!-- recording indicator -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Pill}" Background="{DynamicResource RedSoftBrush}" BorderBrush="{DynamicResource RedEdgeBrush}"
                                    Padding="7,1,8,2" IsHitTestVisible="False" Visibility="{Binding GameMonitor.IsMonitoring, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="REC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentRedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="DIAGNOSE" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,18,0,6" />
                        <RadioButton Content="Targets &amp; probes" Tag="&#xEC05;" GroupName="nav" Style="{StaticResource NavTabButton}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Monitoring}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Monitoring" />
                        <RadioButton Content="Route trace" Tag="&#xE774;" GroupName="nav" Style="{StaticResource NavTabButton}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=RoutePath}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="RoutePath" />
                        <RadioButton Content="Bufferbloat test" Tag="&#xE9D2;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Bufferbloat}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Bufferbloat" />
                        <RadioButton Content="Speed test" Tag="&#xEC4A;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=SpeedTest}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="SpeedTest" />
                        <RadioButton Content="Adapter &amp; Wi-Fi" Tag="&#xE839;" GroupName="nav" Style="{StaticResource NavTabButton}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Adapter}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Adapter" />
                        <RadioButton Content="Probe log" Tag="&#xE9D9;" GroupName="nav" Style="{StaticResource NavTabButton}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=ProbeLog}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="ProbeLog" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SetModeCommand}" CommandParameter="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="16,7" Margin="0,2,0,0" Visibility="{Binding IsBeginnerMode, Converter={StaticResource BoolToVis}}"
                                ToolTip="Advanced adds Targets &amp; probes, Route trace, Adapter &amp; Wi-Fi and the live Probe log">
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE710;" /><Run Text="  4 more tools in Advanced" /></TextBlock>
                        </Button>
                        <TextBlock Text="RECORDS" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,18,0,6" />
                        <RadioButton Content="Event timeline" Tag="&#xE8FD;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Events}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Events" />
                        <RadioButton Content="History &amp; reports" Tag="&#xE81C;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=History}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="History" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Tab Content Switcher -->
            <Grid Grid.Column="1" Margin="32,26,32,22" MaxWidth="1440">

                <!-- TAB 1: OVERVIEW / DASHBOARD -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- One-time welcome: choose how much detail -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1.5"
                                Visibility="{Binding ShowModeChooser, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Welcome to NetPulse. How much detail do you want?" Style="{StaticResource CardTitle}" FontSize="17" />
                                <TextBlock Text="You can change this any time with the Beginner / Advanced switch at the top." Style="{StaticResource CardSubtitle}" />
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding ChooseModeCommand}" CommandParameter="Beginner" Margin="0,0,8,0" Cursor="Hand" AutomationProperties.Name="Choose Beginner">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16,14">
                                                    <StackPanel>
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE76E;" Foreground="{DynamicResource AccentBlueBrush}" /><Run Text="  Beginner" /></TextBlock>
                                                        <TextBlock Text="Plain-language verdicts, the 'Ready to play?' checklist, the Game Monitor and your recordings. Just what you need to know if your connection is OK." FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Command="{Binding ChooseModeCommand}" CommandParameter="Advanced" Margin="8,0,0,0" Cursor="Hand" AutomationProperties.Name="Choose Advanced">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16,14">
                                                    <StackPanel>
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" Foreground="{DynamicResource AccentBlueBrush}" /><Run Text="  Advanced" /></TextBlock>
                                                        <TextBlock Text="Everything: per-server statistics, raw connection tables, route tracing, adapter details, HTTPS timings and a live log of every probe." FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Status hero: tinted by the overall verdict -->
                        <Border CornerRadius="14" Padding="22,20" Margin="0,0,0,16" BorderThickness="1" Background="{Binding StatusSoftBrush}" BorderBrush="{Binding StatusEdgeBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="52" Height="52" CornerRadius="26" Background="{Binding StatusBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource IconFont}" FontSize="23" Foreground="{DynamicResource BgDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Connection status" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Background="Transparent" BorderBrush="{Binding StatusBrush}">
                                            <TextBlock Text="{Binding StatusCategory}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" TextWrapping="NoWrap" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusHeadline}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,4" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LikelyCause}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource ScrimBrush}" CornerRadius="10" Padding="16,12" VerticalAlignment="Center" Margin="20,0,0,0" MaxWidth="300">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE82F;" /><Run Text="  Recommended next step" /></TextBlock>
                                        <TextBlock Text="{Binding RecommendedAction}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Headline numbers -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <controls:StatTile Margin="0,0,8,0" Label="Reference ping" Glyph="&#xE774;" Unit="ms" Info="{Binding TipLatency}"
                                               Value="{Binding QuickInternetLatency, StringFormat={}{0:F1}}" Caption="Typical ping to public servers (not a game server)" Badge="{Binding PingBadge}" BadgeBrush="{Binding PingBadgeBrush}" />
                            <controls:StatTile Margin="8,0,8,0" Label="Latency variation" Glyph="&#xE9D2;" Unit="ms" Info="{Binding TipVariation}" Accent="#A78BFA"
                                               Value="{Binding QuickJitter, StringFormat={}{0:F1}}" Caption="How much ping swings, last 60 s" Badge="{Binding JitterBadge}" BadgeBrush="{Binding JitterBadgeBrush}" />
                            <controls:StatTile Margin="8,0,8,0" Label="Probe loss" Glyph="&#xE711;" Unit="%" Info="{Binding TipLoss}" Accent="#F472B6"
                                               Value="{Binding QuickPacketLoss, StringFormat={}{0:F1}}" Caption="Test messages with no reply, last 60 s" Badge="{Binding LossBadge}" BadgeBrush="{Binding LossBadgeBrush}" />
                            <controls:StatTile Margin="8,0,0,0" Label="Your router" Glyph="&#xE968;" Unit="ms" Info="{Binding TipRouter}" Accent="#2DD4BF"
                                               Value="{Binding QuickGatewayLatency, StringFormat={}{0:F1}}" Caption="This PC to your router (the first step)" Badge="{Binding RouterBadge}" BadgeBrush="{Binding RouterBadgeBrush}" />
                        </UniformGrid>

                        <!-- Ready to play? -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{Binding ReadinessBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding ReadinessGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource BgDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ready to play?" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding ReadinessHeadline}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding CopySummaryCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" MinHeight="32" FontSize="12.5" VerticalAlignment="Top" Margin="12,0,0,0"
                                            AutomationProperties.Name="Copy summary" ToolTip="Copy a short text snapshot of your connection (no IP addresses or network names) to paste into a chat or a support ticket. Ctrl+Shift+C">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding CopySummaryText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ReadinessItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{Binding Brush}" Margin="0,2,0,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Detail}" FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        <Button Content="Run the Bufferbloat test" Style="{StaticResource OutlineButton}" Padding="10,3" MinHeight="28" FontSize="12.5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                                Command="{Binding DataContext.OpenBufferbloatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Visibility="{Binding IsUntestedLoad, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ReadinessScope}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Live graph of the last few minutes -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ping over time" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Your router and the public reference servers. Hover the graph to read exact values." Style="{StaticResource CardSubtitle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="170" ItemsSource="{Binding LiveWindows}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding LiveMinutes, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Graph time range" />
                                </Grid>
                                <controls:SessionChart Height="190" Data="{Binding LiveChart}" TargetOrder="{Binding LiveChartOrder}" AutomationProperties.Name="Live ping graph" />
                                <ItemsControl ItemsSource="{Binding LiveLegend}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Background="Transparent">
                                                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="8,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding LiveChartCaption}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Game + latest event: what is being watched and what happened last -->
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BlueSoftBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Game Monitor" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding GameCardTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,2" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding GameCardDetail}" FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Content="Open Game Monitor" Command="{Binding SwitchTabCommand}" CommandParameter="GameMonitor" Style="{StaticResource OutlineButton}" Padding="12,5" MinHeight="32" FontSize="12.5" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AmberSoftBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Latest issue" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding LatestEventText}" FontSize="13.5" LineHeight="19" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,2" TextWrapping="Wrap" />
                                        <Button Content="Open event timeline" Command="{Binding SwitchTabCommand}" CommandParameter="Events" Style="{StaticResource OutlineButton}" Padding="12,5" MinHeight="32" FontSize="12.5" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- The measurement chain -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="What NetPulse measures, step by step" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Each step is a separate measurement. If the router is slow, the problem is in your home; if only the internet step is slow, it is further away. The internet step uses public reference servers, not your game's servers."
                                           Style="{StaticResource CardSubtitle}" Margin="0,3,0,18" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource ChainNodeIcon}"><TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="This PC" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding ActiveNic.Ipv4Address}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding AdapterStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Style="{StaticResource ChainConnector}">
                                        <Border Height="2" Background="{DynamicResource BorderStrongBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BgCardBrush}" HorizontalAlignment="Center" Padding="4,0">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource ChainNodeIcon}"><TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="Home router" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding ActiveNic.Ipv4Gateway}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding QuickGatewayLatency, StringFormat='{}{0:F1} ms'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <Grid Grid.Column="3" Style="{StaticResource ChainConnector}">
                                        <Border Height="2" Background="{DynamicResource BorderStrongBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BgCardBrush}" HorizontalAlignment="Center" Padding="4,0">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="4">
                                        <Border Style="{StaticResource ChainNodeIcon}"><TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="Internet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="Public reference servers" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Text="{Binding QuickInternetLatency, StringFormat='{}{0:F1} ms'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <Grid Grid.Column="5" Style="{StaticResource ChainConnector}">
                                        <Border Height="2" Background="{DynamicResource BorderStrongBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BgCardBrush}" HorizontalAlignment="Center" Padding="4,0">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="6">
                                        <Border Style="{StaticResource ChainNodeIcon}"><TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="DNS lookups" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="Names into addresses" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Text="{Binding QuickDnsLatency, StringFormat='{}{0:F1} ms'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Advanced: every server at a glance -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Per-server statistics" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Now vs each server's own usual latency (learned over the history window), the 95th percentile, variation and loss in the recent window." Style="{StaticResource CardSubtitle}" />
                                <DataGrid ItemsSource="{Binding Targets}" IsReadOnly="True" MaxHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Server" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding TargetName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Now" Binding="{Binding LatencyDisplay}" Width="85" />
                                        <DataGridTextColumn Header="Usual" Binding="{Binding BaselineDisplay}" Width="95" />
                                        <DataGridTextColumn Header="P95" Binding="{Binding P95Display}" Width="85" />
                                        <DataGridTextColumn Header="Variation" Binding="{Binding JitterDisplay}" Width="85" />
                                        <DataGridTextColumn Header="Loss" Binding="{Binding LossDisplay}" Width="70" />
                                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Advanced mode: full diagnostic evidence -->
                        <Border Style="{StaticResource CardPanel}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Measured evidence behind the verdict" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding EvidenceSummary}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Beginner mode: short pointer instead of raw evidence -->
                        <controls:Callout Kind="Info" Visibility="{Binding IsBeginnerMode, Converter={StaticResource BoolToVis}}"
                                          Title="Want the numbers behind this verdict?" Text="Switch to Advanced (top right) for per-server statistics, the measured evidence, route tracing and a live log of every probe." />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: GAME MONITOR -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="GameMonitor">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel DataContext="{Binding GameMonitor}">
                        <controls:PageHeader Title="Game Monitor" Glyph="&#xE7FC;"
                                             Subtitle="Watches a game on this PC, lists the connections its process opens, and records how your connection behaves while you play. Nothing leaves your PC." />

                        <!-- Game selection + process status -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Width="300" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                              DisplayMemberPath="Display" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" />
                                    <DockPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding ProcessBrush}" Margin="0,5,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ProcessStatus}" FontSize="14" FontWeight="SemiBold" LineHeight="19" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Grid>
                                <TextBlock Text="{Binding ProfileSummary}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Open official status page" Command="{Binding OpenStatusPageCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" FontSize="12.5" />
                                    <TextBlock Text="{Binding StatusPageText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Expander Header="Known limitations for this game" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" FontSize="13.5">
                                    <TextBlock Text="{Binding LimitationsText}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Controls -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding StartCommand}" Padding="16,8" AutomationProperties.Name="Start monitoring">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Start monitoring" /></StackPanel>
                                    </Button>
                                    <Button Content="Stop &amp; save" Command="{Binding StopCommand}" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="8,0,0,0" />
                                    <Button Command="{Binding MarkLagCommand}" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="8,0,0,0" AutomationProperties.Name="Mark lag"
                                            ToolTip="Press when you notice lag so it can be matched against the measurements">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AccentAmberBrush}" /><TextBlock Text="Mark lag" /></StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenSessionsFolderCommand}" Style="{StaticResource GhostButton}" Padding="12,8" Margin="4,0,0,0" ToolTip="Open the folder where recordings are saved" AutomationProperties.Name="Open sessions folder">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="Open folder" /></StackPanel>
                                    </Button>
                                    <Border Margin="16,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource RedSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource RedEdgeBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="SemiBold" FontSize="12.5" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Not recording" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                            <Setter Property="Text" Value="● RECORDING" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,0,0,0" Typography.NumeralAlignment="Tabular" ToolTip="Time recorded" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource MessageText}" Foreground="{DynamicResource AccentBlueHoverBrush}" Margin="0,12,0,0" />
                                <controls:Callout Kind="Success" Text="{Binding SessionMessage}" Margin="0,12,0,0">
                                    <controls:Callout.Style>
                                        <Style TargetType="controls:Callout" BasedOn="{StaticResource {x:Type controls:Callout}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SessionMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:Callout.Style>
                                </controls:Callout>
                                <Button Content="Open this recording" Command="{Binding OpenRecordingCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" FontSize="12.5"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}" />
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14" />
                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoRecord, Mode=TwoWay}"
                                          Content="Record automatically: start when the game starts, save when it closes" />
                                <TextBlock Margin="52,4,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"><Run FontFamily="{StaticResource IconFont}" Text="&#xE765;" /><Run Text="  " /><Run Text="{Binding MarkLagShortcutText, Mode=OneWay}" /></TextBlock>
                                <controls:Callout Kind="Warning" Text="{Binding WarningText}" Margin="0,10,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Beginner: what the game is connected to, in one card -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Visibility="{Binding DataContext.IsBeginnerMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="What the game is connected to" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding EndpointSummary}" Style="{StaticResource MessageText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding ConnectionsEmptyText}" Style="{StaticResource MessageText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                           Visibility="{Binding ShowConnectionsEmptyText, Converter={StaticResource BoolToVis}}" />
                                <controls:Callout Kind="Warning" Title="The match itself is not in the list" Text="{Binding MatchTrafficText}" Margin="0,10,0,0"
                                                  Visibility="{Binding MatchTrafficHidden, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Advanced mode lists every connection, what it probably is, and lets you measure one yourself." Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Game connections -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Connections opened by the game" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Every address is labelled 'Unknown role': a game also talks to login, matchmaking, telemetry, voice and download services, so none of these is assumed to be the match server."
                                           Style="{StaticResource CardSubtitle}" />
                                <controls:Callout Kind="Warning" Title="The match itself is not in this list" Text="{Binding MatchTrafficText}" Margin="0,0,0,12"
                                                  Visibility="{Binding MatchTrafficHidden, Converter={StaticResource BoolToVis}}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding EndpointSummary}" Style="{StaticResource MessageText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="{Binding GroupRepeats, Mode=TwoWay}" Content="Group repeated connections" FontSize="13"
                                              ToolTip="Games reconnect to the same web services every minute or two. Grouped, each endpoint is one row with a count." Margin="16,0,0,0" />
                                </Grid>
                                <Grid>
                                    <DataGrid ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" IsReadOnly="True"
                                              AutoGenerateColumns="False" SelectionMode="Single" MaxHeight="300" MinHeight="170">
                                        <DataGrid.RowStyle>
                                            <!-- web/API rows are quieter: they are very unlikely to be the match -->
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWebService}" Value="True"><Setter Property="Opacity" Value="0.6" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70" />
                                            <DataGridTextColumn Header="Remote endpoint" Binding="{Binding Remote}" Width="190" />
                                            <DataGridTemplateColumn Header="What it probably is" Width="190">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Kind}" ToolTip="{Binding KindExplanation}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Cursor="Help" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Seen" Binding="{Binding OccurrencesText}" Width="55" />
                                            <DataGridTextColumn Header="Where" Binding="{Binding Scope}" Width="110" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                            <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}" Width="80" />
                                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="80" />
                                            <DataGridTextColumn Header="Measured by" Binding="{Binding MeasuredBy}" Width="90" />
                                            <DataGridTextColumn Header="Local endpoint" Binding="{Binding Local}" Width="170" />
                                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <controls:EmptyState Glyph="&#xE7FC;" Title="No connections yet" Text="{Binding ConnectionsEmptyText}" Margin="20,40,20,0"
                                                         Visibility="{Binding ShowConnectionsEmptyText, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Measure selected with ICMP ping" Command="{Binding MeasureIcmpCommand}" Padding="12,6" FontSize="12.5" />
                                    <Button Content="Measure selected with TCP connect" Command="{Binding MeasureTcpCommand}" Style="{StaticResource OutlineButton}" Padding="12,6" FontSize="12.5" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedConnectionHint}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Measured endpoints -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Endpoints you chose to measure" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                                <Grid>
                                    <DataGrid ItemsSource="{Binding MeasuredEndpoints}" SelectedItem="{Binding SelectedMeasured, Mode=TwoWay}" IsReadOnly="True"
                                              AutoGenerateColumns="False" SelectionMode="Single" MaxHeight="180" MinHeight="50">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Name}" Width="170" />
                                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
                                            <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="80" />
                                            <DataGridTextColumn Header="Variation" Binding="{Binding Variation}" Width="80" />
                                            <DataGridTextColumn Header="Packet loss (recent window)" Binding="{Binding Loss}" Width="220" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                                <TextBlock Text="No endpoint is being measured. Start monitoring, select a connection above, then choose a method." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <Button Content="Stop measuring selected" Command="{Binding StopMeasuringCommand}" Style="{StaticResource OutlineButton}" Padding="12,6" FontSize="12.5" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Reference measurements -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Reference measurements (not game-server ping)" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding MeasurementNote}" Style="{StaticResource CardSubtitle}" />
                                <DataGrid ItemsSource="{Binding ReferenceTargets}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Name}" Width="190" />
                                        <DataGridTextColumn Header="What it is" Binding="{Binding Kind}" Width="230" />
                                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="70" />
                                        <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="80" />
                                        <DataGridTextColumn Header="Variation" Binding="{Binding Variation}" Width="80" />
                                        <DataGridTextColumn Header="Packet loss (recent window)" Binding="{Binding Loss}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Findings -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What the measurements suggest" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Possibilities backed by measurements, not verdicts. Each shows how confident NetPulse is and what to test next." Style="{StaticResource CardSubtitle}" />
                                <ItemsControl ItemsSource="{Binding Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{Binding Brush}" BorderThickness="3,0,0,0" Background="{DynamicResource BgInputBrush}" Padding="14,10" Margin="0,0,0,8" CornerRadius="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ConfidenceText, StringFormat='   ({0})'}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Observations}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding NextTest, StringFormat='Next test: {0}'}" FontSize="13.5" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding NoFindingsText}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Timeline -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Session timeline" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                                <DataGrid RowHeight="NaN" MinRowHeight="40" ItemsSource="{Binding Timeline}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="260" MinHeight="50">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, Converter={StaticResource LocalTime}}" Width="80" />
                                        <DataGridTextColumn Header="What happened" Binding="{Binding EventType, Converter={StaticResource EventLabel}}" Width="170" />
                                        <DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Game start/exit, connection changes, your lag markers, monitoring gaps and network events appear here while monitoring." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: TARGETS & MONITORING -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Monitoring">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:PageHeader Grid.Row="0" Title="Targets &amp; probes" Glyph="&#xEC05;"
                                         Subtitle="Your router and several independent public servers, tested about once a second. They judge your connection in general; they are not your game's servers." />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Targets}">
                        <DataGrid.Columns>
                            <!-- Target Name -->
                            <DataGridTemplateColumn Header="Target" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding TargetHost}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Protocol -->
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />

                            <!-- Current RTT -->
                            <DataGridTemplateColumn Header="Latency" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LatencyDisplay}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rolling Avg -->
                            <DataGridTextColumn Header="Usual" Binding="{Binding BaselineDisplay}" Width="95" />
                            <DataGridTextColumn Header="P95" Binding="{Binding P95Display}" Width="85" />

                            <!-- Min / Max -->
                            <DataGridTemplateColumn Header="Min / Max" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MinLatency, StringFormat='{}{0:F0} / '}" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding MaxLatency, StringFormat='{}{0:F0} ms', Mode=OneWay}" />
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Jitter -->
                            <DataGridTextColumn Header="Jitter (RFC3550)" Binding="{Binding JitterDisplay}" Width="110" />

                            <!-- Packet Loss -->
                            <DataGridTextColumn Header="Loss (last 60 s)" Binding="{Binding LossDisplay}" Width="150" />

                            <!-- Sparkline Chart -->
                            <DataGridTemplateColumn Header="HTTPS timing" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HttpsTimingDisplay}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   ToolTip="Where the last HTTPS probe's time went: name lookup, TCP connect, TLS handshake, first byte of the response" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Recent history" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:SparklineChart Values="{Binding ChartValues}" LineBrush="{Binding StatusBrush}" Height="28" Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- TAB 3: ROUTE & MTR -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="RoutePath">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:PageHeader Grid.Row="0" Title="Route trace" Glyph="&#xE774;"
                                         Subtitle="Each device (hop) your data passes through. A slow or lossy hop only matters if the hops after it are slow too; many routers simply ignore probes." />

                    <!-- MTR Target Input Bar -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Trace to" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13.5" Margin="4,0,12,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding MtrDestination, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="An IP address or host name" AutomationProperties.Name="Trace destination" />

                            <Button Grid.Column="2" Content="Start trace" Command="{Binding StartMtrCommand}" Margin="10,0,6,0" />
                            <Button Grid.Column="3" Content="Stop" Style="{StaticResource OutlineButton}" Command="{Binding StopMtrCommand}" />

                            <TextBlock Grid.Column="4" Text="{Binding MtrStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13.5" />
                        </Grid>
                    </Border>

                    <!-- MTR Hops Table -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding MtrHops}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hop" Binding="{Binding HopNumber}" Width="50" />
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="140" />
                            <DataGridTextColumn Header="Hostname / rDNS" Binding="{Binding DisplayHost}" Width="200" />
                            <DataGridTextColumn Header="Current (ms)" Binding="{Binding CurrentRttMs, StringFormat='{}{0:F1}'}" Width="90" />
                            <DataGridTextColumn Header="Avg (ms)" Binding="{Binding AvgRttMs, StringFormat='{}{0:F1}'}" Width="80" />
                            <DataGridTextColumn Header="Best (ms)" Binding="{Binding MinRttMs, StringFormat='{}{0:F1}'}" Width="80" />
                            <DataGridTextColumn Header="Worst (ms)" Binding="{Binding MaxRttMs, StringFormat='{}{0:F1}'}" Width="80" />
                            <DataGridTextColumn Header="Loss %" Binding="{Binding LossPercent, StringFormat='{}{0:F0}%'}" Width="70" />
                            <DataGridTextColumn Header="ASN / Organization" Binding="{Binding AsDisplay}" Width="160" />
                            <DataGridTemplateColumn Header="Diagnostics" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Sustained jump" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="SemiBold"
                                                       >
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPersistentLatencyIncrease}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:EmptyState Grid.Row="2" Glyph="&#xE774;" Title="No trace yet" Text="Press Start trace to follow the path to the address above, hop by hop."
                                         Visibility="{Binding HasNoHops, Converter={StaticResource BoolToVis}}" />

                    <!-- Route Anomalies & Path Comparison -->
                    <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Route Anomalies -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="What stands out on this route" Style="{StaticResource CardTitle}" FontSize="15" Margin="0,0,0,8" />
                                <TextBlock Text="Run a trace: hops that add delay or lose probes, and whether that carries on to the destination, are listed here." Style="{StaticResource CaptionText}"
                                           Visibility="{Binding HasNoHops, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding RouteAnomalies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="16,0" />

                            <!-- Right: Path Comparison Tool -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Compare two destinations" Style="{StaticResource CardTitle}" FontSize="15" Margin="0,0,0,2" />
                                <TextBlock Text="Shows where the two paths split, which tells you how far a shared problem reaches." Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Text="{Binding PathCompareDestA}" Width="130" AutomationProperties.Name="First destination" />
                                    <TextBlock Text="vs" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0" />
                                    <TextBox Text="{Binding PathCompareDestB}" Width="130" AutomationProperties.Name="Second destination" />
                                    <Button Content="Compare" Command="{Binding ComparePathsCommand}" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding PathCompareSummary}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 4: BUFFERBLOAT TEST -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Bufferbloat">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <controls:PageHeader Title="Bufferbloat test" Glyph="&#xE9D2;"
                                             Subtitle="How much your ping rises while your connection is busy downloading or uploading. This is the lag you feel when someone else at home starts a big download." />
                        <controls:Callout Kind="Info" Title="{Binding TransferProviderTitle}" Text="{Binding TransferDisclosure}" Margin="0,0,0,16" />

                        <!-- Runner -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Three short phases, about 30 seconds" Style="{StaticResource CardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Style="{StaticResource Pill}"><TextBlock Text="1  Ping at rest" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" /></Border>
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                            <Border Style="{StaticResource Pill}"><TextBlock Text="2  Ping while downloading" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" /></Border>
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                            <Border Style="{StaticResource Pill}"><TextBlock Text="3  Ping while uploading" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" /></Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding RunBufferbloatCommand}" Padding="16,8" AutomationProperties.Name="Start bufferbloat test">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Start test" /></StackPanel>
                                        </Button>
                                        <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelBufferbloatCommand}" Padding="16,8" Margin="8,0,0,0"
                                                Visibility="{Binding IsBufferbloatRunning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Height="6" Value="{Binding BufferbloatProgress}" Maximum="100" Margin="0,18,0,8" />
                                <Grid>
                                    <TextBlock Text="{Binding BufferbloatStatus}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding BufferbloatLiveText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"
                                               Visibility="{Binding IsBufferbloatRunning, Converter={StaticResource BoolToVis}}" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Result -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="150" Height="150" VerticalAlignment="Top">
                                    <controls:RingGauge Value="1" Maximum="1" Sweep="360" Thickness="10" Brush="{Binding GradeBrush}" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LatestBufferbloatResult.Grade, FallbackValue='?'}" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="SemiBold"
                                                   Foreground="{Binding GradeBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        <TextBlock Text="Grade" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                    <TextBlock Text="{Binding LatestBufferbloatResult.Summary, FallbackValue='No result yet'}" FontWeight="SemiBold" FontSize="18" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LatestBufferbloatResult.Explanation, FallbackValue='Run the test to see how much your ping rises under load. A small rise is normal; a big one means the router is queueing too much.'}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                    <UniformGrid Columns="3" Margin="0,18,0,14">
                                        <Border Background="{DynamicResource BgInputBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="At rest" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding LatestBufferbloatResult.BaselineLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='-'}" Style="{StaticResource BigNumber}" FontSize="22" Margin="0,4,0,0" />
                                                <TextBlock Text="baseline ping" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgInputBrush}" CornerRadius="10" Padding="14,12" Margin="6,0,6,0">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE896;" /><Run Text="  Downloading" /></TextBlock>
                                                <TextBlock Text="{Binding LatestBufferbloatResult.DownloadLoadedLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='-'}" Style="{StaticResource BigNumber}" FontSize="22" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding LatestBufferbloatResult.DownloadDeltaMs, StringFormat='{}+{0:F1} ms over rest', FallbackValue=' '}" FontSize="12" Foreground="{DynamicResource AccentAmberBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgInputBrush}" CornerRadius="10" Padding="14,12" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE898;" /><Run Text="  Uploading" /></TextBlock>
                                                <TextBlock Text="{Binding LatestBufferbloatResult.UploadLoadedLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='-'}" Style="{StaticResource BigNumber}" FontSize="22" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding LatestBufferbloatResult.UploadDeltaMs, StringFormat='{}+{0:F1} ms over rest', FallbackValue=' '}" FontSize="12" Foreground="{DynamicResource AccentAmberBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <controls:Callout Kind="Success" Title="Recommendation" Text="{Binding LatestBufferbloatResult.Recommendation}"
                                                      Visibility="{Binding HasBufferbloatResult, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 5: SPEED TEST -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="SpeedTest">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <controls:PageHeader Title="Speed test" Glyph="&#xEC4A;"
                                             Subtitle="Download and upload throughput over several parallel streams. Speed matters for downloads and streaming; for games, steady ping matters far more." />
                        <controls:Callout Kind="Info" Title="{Binding TransferProviderTitle}" Text="{Binding TransferDisclosure}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="About 10 seconds of heavy traffic" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Run it once in a while, not continuously, and not while you are playing: it fills your connection on purpose." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding RunSpeedTestCommand}" Padding="16,8" AutomationProperties.Name="Run speed test">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Run speed test" /></StackPanel>
                                        </Button>
                                        <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelSpeedTestCommand}" Padding="16,8" Margin="8,0,0,0"
                                                Visibility="{Binding IsSpeedTestRunning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Height="6" Value="{Binding SpeedTestProgress}" Maximum="100" Margin="0,18,0,8" Foreground="{DynamicResource AccentGreenBrush}" />
                                <TextBlock Text="{Binding SpeedTestStatus}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0" Padding="20,22">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"><Run FontFamily="{StaticResource IconFont}" Text="&#xE896;" Foreground="{DynamicResource AccentGreenBrush}" /><Run Text="  Download" /></TextBlock>
                                    <Grid Width="210" Height="190" Margin="0,12,0,0">
                                        <controls:RingGauge Width="190" Height="190" Value="{Binding DownloadMbps}" Maximum="{Binding SpeedGaugeMax}" Thickness="12" Sweep="270" Brush="{DynamicResource AccentGreenBrush}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DownloadMbps, StringFormat={}{0:F1}}" Style="{StaticResource BigNumber}" FontSize="38" HorizontalAlignment="Center" />
                                            <TextBlock Text="Mbps" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding LatestSpeedTestResult.BytesDownloaded, StringFormat='{}{0:N0} bytes transferred', FallbackValue=' '}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,-14,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0" Padding="20,22">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"><Run FontFamily="{StaticResource IconFont}" Text="&#xE898;" Foreground="{DynamicResource AccentBlueHoverBrush}" /><Run Text="  Upload" /></TextBlock>
                                    <Grid Width="210" Height="190" Margin="0,12,0,0">
                                        <controls:RingGauge Width="190" Height="190" Value="{Binding UploadMbps}" Maximum="{Binding SpeedGaugeMax}" Thickness="12" Sweep="270" Brush="{DynamicResource AccentBlueBrush}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding UploadMbps, StringFormat={}{0:F1}}" Style="{StaticResource BigNumber}" FontSize="38" HorizontalAlignment="Center" />
                                            <TextBlock Text="Mbps" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding LatestSpeedTestResult.BytesUploaded, StringFormat='{}{0:N0} bytes transferred', FallbackValue=' '}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,-14,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding SpeedGaugeScale}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 6: ADAPTER & WI-FI -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Adapter">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <controls:PageHeader Title="Adapter &amp; Wi-Fi" Glyph="&#xE839;"
                                             Subtitle="The network adapter Windows is using right now: link, addresses, router and DNS servers, and Wi-Fi radio details when you are on Wi-Fi." />

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BlueSoftBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveNic.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ActiveNic.Description}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /></Grid.RowDefinitions>
                                        <TextBlock Text="Type" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ActiveNic.InterfaceType}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="Link speed" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveNic.SpeedDisplay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="Status" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource GreenSoftBrush}" BorderBrush="{DynamicResource GreenEdgeBrush}">
                                            <TextBlock Text="{Binding ActiveNic.OperationalStatus}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" TextWrapping="NoWrap" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Addresses and routing" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="IPv4 address" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ActiveNic.Ipv4Address}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="Subnet mask" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveNic.Ipv4Subnet}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="Router (gateway)" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveNic.Ipv4Gateway}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueHoverBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Text="DNS servers" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                                        <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ActiveNic.DnsServers}" Margin="0,7,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Wi-Fi -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,12"><Run FontFamily="{StaticResource IconFont}" Text="&#xE701;" Foreground="{DynamicResource AccentBlueHoverBrush}" /><Run Text="  Wi-Fi radio" /></TextBlock>
                                <TextBlock Text="{Binding NonWifiNote}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding ShowEthernetNote, Converter={StaticResource BoolToVis}}" />
                                <UniformGrid Columns="4" Visibility="{Binding ShowWifiDetails, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Network name (SSID)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiSsid, FallbackValue='Not connected'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Signal strength" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiSignalPercent, StringFormat='{}{0}%', FallbackValue='N/A'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Wi-Fi standard" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiRadioType, FallbackValue='N/A'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Channel" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiChannel, FallbackValue='N/A'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 7: EVENT TIMELINE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Events">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:PageHeader Grid.Row="0" Title="Event timeline" Glyph="&#xE8FD;"
                                         Subtitle="What happened, newest first, in your local time. Repeated identical events are collapsed.">
                        <controls:PageHeader.Actions>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding ShowProblemsOnly, Mode=TwoWay}" Content="Problems only" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Content="Clear" Style="{StaticResource OutlineButton}" Command="{Binding ClearEventsCommand}" ToolTip="Clear the timeline (saved recordings keep their own events)" />
                            </StackPanel>
                        </controls:PageHeader.Actions>
                    </controls:PageHeader>

                    <DataGrid RowHeight="NaN" MinRowHeight="44" Grid.Row="1" ItemsSource="{Binding EventsView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, Converter={StaticResource LocalTime}}" Width="84" />
                            <DataGridTemplateColumn Header="Level" Width="104">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pill}" Padding="8,1,9,2" BorderBrush="{Binding Severity, Converter={DynamicResource SeverityBrush}}" Background="Transparent">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityLabel}}" Foreground="{Binding Severity, Converter={DynamicResource SeverityBrush}}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="What happened" Binding="{Binding EventType, Converter={StaticResource EventLabel}}" Width="180" />
                            <DataGridTextColumn Header="Where" Binding="{Binding TargetName}" Width="170" />
                            <DataGridTemplateColumn Header="Details" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4" LineHeight="18" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState Grid.Row="1" Glyph="&#xE8FD;" Title="Nothing to show yet" Text="{Binding NoEventsText}"
                                         Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- TAB: PROBE LOG (Advanced) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="ProbeLog">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:PageHeader Title="Probe log" Glyph="&#xE9D9;"
                                         Subtitle="Every measurement as it happens: which server, which method, the round-trip time or why there was no reply. The raw data behind every number in NetPulse." />

                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Width="260" ItemsSource="{Binding ProbeLogTargets}" SelectedItem="{Binding ProbeLogTarget, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Probe log server filter" />
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="{Binding ProbeLogFailuresOnly, Mode=TwoWay}" Content="No reply only" FontSize="13.5" Margin="18,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ProbeLogSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="18,0,12,0" />
                            <Button Grid.Column="3" Content="{Binding ProbeLogPauseText}" Command="{Binding ToggleProbeLogPauseCommand}" Style="{StaticResource OutlineButton}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding ProbeLog}" IsReadOnly="True" RowHeight="34" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="110" />
                            <DataGridTextColumn Header="Server" Binding="{Binding Target}" Width="220" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="140" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="80" />
                            <DataGridTemplateColumn Header="Result" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Result}" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState Grid.Row="2" Glyph="&#xE9D9;" Title="Waiting for probes" Text="Measurements appear here as they are made, about once a second per server."
                                         Visibility="{Binding ProbeLog.Count, Converter={StaticResource ZeroToVis}}" />
                </Grid>

                <!-- TAB: HELP & GLOSSARY -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Help">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <controls:PageHeader Title="Help &amp; glossary" Glyph="&#xE897;" Subtitle="What the words mean, and what NetPulse can and cannot tell you." />

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What NetPulse does, and does not, measure" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding HelpMeasuresText}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Beginner and Advanced" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run FontWeight="SemiBold" Text="Beginner" /><Run Text=" keeps to plain-language verdicts: the connection status, the 'Ready to play?' checklist, headline numbers with a one-word rating, the Game Monitor summary, Bufferbloat and Speed tests, the event timeline and your recordings." />
                                    <LineBreak /><LineBreak />
                                    <Run FontWeight="SemiBold" Text="Advanced" /><Run Text=" adds per-server statistics (usual latency, 95th percentile, variation), the measured evidence behind each verdict, every connection the game opens with the option to measure it, route tracing, adapter and Wi-Fi details, HTTPS timing breakdowns, the live probe log, and how each glossary term is measured." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+1 … Ctrl+9, Ctrl+0" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Open the 1st … 10th page of the sidebar" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Shift+C" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Copy a short summary of your connection" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="2" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+E" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Export a diagnostic report" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="3" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Shift+O" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Show or hide the mini overlay" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="4" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+T" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Switch between light and dark" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="5" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+," FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Settings" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="6" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="F1" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="This page" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="7" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="{Binding MarkLagKeyText}" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Mark lag while recording; works while a game has focus (change it in Settings)" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Glossary" Style="{StaticResource CardTitle}" FontSize="18" Margin="2,8,0,10" />
                        <ItemsControl ItemsSource="{Binding Glossary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardPanel}" Margin="0,0,10,10" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Term}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AccentBlueHoverBrush}" />
                                            <TextBlock Text="{Binding Plain}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Switch to Advanced mode (top right) to also see how each value is measured." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding IsBeginnerMode, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: HISTORY & REPORTS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="History">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel Margin="0,0,10,0">
                        <controls:PageHeader Title="History &amp; reports" Glyph="&#xE81C;"
                                             Subtitle="Everything you have recorded, kept on this PC. Open a recording to see its graph, what happened around the moments you marked as laggy, and export a report." />

                        <!-- Recordings list -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding History}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recordings" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" />
                                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" IsReadOnly="True" SelectionMode="Single" MaxHeight="260" MinHeight="64">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Recording" Binding="{Binding Name}" Width="*" MinWidth="220" />
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartedText}" Width="150" />
                                            <DataGridTextColumn Header="Length" Binding="{Binding DurationText}" Width="100" />
                                            <DataGridTextColumn Header="Probes" Binding="{Binding SamplesText}" Width="110" />
                                            <DataGridTextColumn Header="Events" Binding="{Binding EventsText}" Width="90" />
                                            <DataGridTextColumn Header="Lag marked" Binding="{Binding LagText}" Width="105" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" IsHitTestVisible="False"
                                                Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="No recordings yet" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Start one from the Game Monitor, or use 'Record a network session' below." Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBlueHoverBrush}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding StorageText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Time of day -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding History.Patterns}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="When is my connection worst?" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Every recording pooled by hour of the day. Each server is compared with its own usual ping, so the bars show extra delay and probe loss, not distance." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding ButtonText}" Command="{Binding AnalyzeCommand}" Style="{StaticResource OutlineButton}" VerticalAlignment="Top" Margin="12,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Bars}" Margin="0,10,0,0" Visibility="{Binding HasBars, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Time of day chart">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,0" ToolTip="{Binding Tip}" Background="Transparent">
                                                <Grid Height="84">
                                                    <Border x:Name="bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="3,3,1,1" Background="{DynamicResource AccentGreenBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentAmberBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Bad"><Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="None"><Setter TargetName="bar" Property="Background" Value="{DynamicResource BorderBrush}" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" Margin="0,12,0,0" AutomationProperties.Name="Time of day summary" />
                                <TextBlock Text="{Binding Progress}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Selected recording -->
                        <StackPanel DataContext="{Binding History}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="2,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DetailSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Export report" Command="{Binding ExportReportCommand}" />
                                    <Button Content="Export probe data (CSV)" Command="{Binding ExportSamplesCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardPanel}" Padding="14,12" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionText}" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Graph -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Graph" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Width="170" ItemsSource="{Binding ModeLabels}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" />
                                    </Grid>
                                    <controls:SessionChart Height="270" Data="{Binding Chart}" TargetOrder="{Binding ChartTargetOrder}" AutomationProperties.Name="Recording graph" />
                                    <ItemsControl ItemsSource="{Binding Legend}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Background="Transparent">
                                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="8,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ChartCaption}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Per-target numbers -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Latency, variation and probe loss per target" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                    <TextBlock Text="Reference servers describe your connection in general; they are not the game's server." Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                                    <DataGrid ItemsSource="{Binding TargetStats}" IsReadOnly="True" MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Name}" Width="190" />
                                            <DataGridTextColumn Header="What it is" Binding="{Binding Kind}" Width="*" />
                                            <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="80" />
                                            <DataGridTextColumn Header="Median" Binding="{Binding Median}" Width="95" />
                                            <DataGridTextColumn Header="95th pct" Binding="{Binding P95}" Width="95" />
                                            <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="95" />
                                            <DataGridTextColumn Header="Variation" Binding="{Binding Variation}" Width="95" />
                                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="130" />
                                            <DataGridTextColumn Header="Probes" Binding="{Binding Probes}" Width="85" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Compare with another recording -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Visibility="{Binding CanCompare, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Compare with another recording" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="For questions like cable vs Wi-Fi, or evening vs morning. Lower is better for every number; changes within normal noise count as the same." Style="{StaticResource CardSubtitle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="300" ItemsSource="{Binding CompareChoices}" SelectedItem="{Binding CompareWith, Mode=TwoWay}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Compare with">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        <TextBlock Text="{Binding StartedText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource GhostButton}" Command="{Binding ClearCompareCommand}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding CompareSummary}" Style="{StaticResource MessageText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,10" />
                                    <DataGrid ItemsSource="{Binding CompareRows}" IsReadOnly="True" MaxHeight="300" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Typical ping, other" Binding="{Binding MedianA}" Width="135" />
                                            <DataGridTextColumn Header="this one" Binding="{Binding MedianB}" Width="90" />
                                            <DataGridTextColumn Header="Change" Binding="{Binding MedianChange}" Width="85" />
                                            <DataGridTextColumn Header="Variation, other" Binding="{Binding VariationA}" Width="115" />
                                            <DataGridTextColumn Header="this one" Binding="{Binding VariationB}" Width="90" />
                                            <DataGridTextColumn Header="Loss, other" Binding="{Binding LossA}" Width="90" />
                                            <DataGridTextColumn Header="this one" Binding="{Binding LossB}" Width="80" />
                                            <DataGridTemplateColumn Header="Overall" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Verdict}" Value="Better"><Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Verdict}" Value="Worse"><Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Lag markers -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Moments you marked as laggy" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                    <TextBlock Text="For each marker, what the measurements showed in the seconds around it, compared with each target's own normal." Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                                    <TextBlock Text="No lag markers in this recording. Press Mark lag while recording to flag a moment." Style="{StaticResource CaptionText}"
                                               Visibility="{Binding HasNoLagMarkers, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding LagMarkers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentAmberBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Note, StringFormat='  -  {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyText}" FontSize="13.5" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Findings -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="What the measurements suggested" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                    <TextBlock Text="Possibilities backed by measurements, each with how sure NetPulse is and what to test next." Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                                    <TextBlock Text="No findings were stored with this recording (findings are produced for Game Monitor recordings)." Style="{StaticResource CaptionText}"
                                               Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVis}}" />
                                    <Border Background="{DynamicResource BgInputBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                            Visibility="{Binding HasVersionNote, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding VersionNote}" Style="{StaticResource CaptionText}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{Binding Brush}" BorderThickness="3,0,0,0" Background="{DynamicResource BgSidebarBrush}" Padding="14,10" Margin="0,0,0,8" CornerRadius="4">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding ConfidenceText, StringFormat='   ({0})'}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Observations}" Style="{StaticResource BodyText}" FontSize="13.5" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding NextTest, StringFormat='Next test: {0}'}" FontSize="13.5" Foreground="{DynamicResource AccentBlueHoverBrush}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                                                   Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Events and notes -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Events" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                    <DataGrid RowHeight="NaN" MinRowHeight="40" ItemsSource="{Binding Events}" IsReadOnly="True" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, Converter={StaticResource LocalTime}}" Width="80" />
                                            <DataGridTextColumn Header="What happened" Binding="{Binding EventType, Converter={StaticResource EventLabel}}" Width="190" />
                                            <DataGridTextColumn Header="Where" Binding="{Binding TargetName}" Width="170" />
                                            <DataGridTemplateColumn Header="Details" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,3" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{Binding ConnectionsText}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                                    <Expander Header="Limitations that applied to this recording" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding LimitationsText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Recording controls -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Record a network session" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Records your connection's latency, variation, probe loss, events, monitoring gaps and the moments you mark as laggy. For a specific game, use the Game Monitor instead." Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Start recording" Command="{Binding StartSessionCommand}" />
                                    <Button Content="Stop &amp; save" Command="{Binding StopSessionCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    <Button Content="Mark lag" Command="{Binding MarkLagCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" ToolTip="Press when you notice lag so it can be compared with what was measured" />
                                </StackPanel>
                                <TextBlock Text="{Binding SessionStatus}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                <Button Content="Open this recording" Command="{Binding OpenLastRecordingCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" FontSize="12.5"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Live exports -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <Expander Header="Export what is on screen right now (not a recording)">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Snapshots of the current state: a readable report, the raw probe log from this run, or a machine-readable JSON file." Style="{StaticResource CaptionText}" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Diagnostic report (.md)" Command="{Binding ExportReportCommand}" />
                                        <Button Content="Probe log (.csv)" Command="{Binding ExportCsvCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                        <Button Content="Snapshot (.json)" Command="{Binding ExportJsonCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: SETTINGS -->
                <Grid DataContext="{Binding Settings}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,12">
                            <controls:PageHeader Title="Settings" Glyph="&#xE713;" Subtitle="Changes take effect as soon as you save. Nothing here is sent anywhere; settings are stored on this PC." />

                            <!-- Appearance (applies immediately, outside the Save/Discard draft) -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding DataContext.Appearance, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Changes here apply straight away." Style="{StaticResource CardSubtitle}" />

                                    <TextBlock Text="Theme" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Themes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        Margin="0,0,10,0" Cursor="Hand" AutomationProperties.Name="{Binding Label}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="14,12">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Accent colour" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Used for buttons, the selected page and highlights." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Accents}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Cursor="Hand" Margin="0,0,10,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid Width="34" Height="34">
                                                                    <Ellipse x:Name="ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Opacity="0" />
                                                                    <Ellipse Fill="{Binding Swatch}" Margin="5" />
                                                                    <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="ring" Property="Opacity" Value="1" />
                                                                        <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Interface size" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Makes all text and controls bigger or smaller, for high-resolution screens or across the room." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Scales}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UiScalePercent, Mode=TwoWay}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Interface size" />
                                    </Grid>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Mini overlay background" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="The overlay (button next to the theme switch, or the tray menu) stays on top of other windows. It shows over games running in windowed or borderless mode, not in exclusive fullscreen." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding OverlayOpacities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OverlayOpacityPercent, Mode=TwoWay}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Overlay background" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Detail level -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Detail level" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Also switchable with Beginner / Advanced at the top of the window. Applies straight away." Style="{StaticResource CardSubtitle}" />
                                    <UniformGrid Columns="2">
                                        <Button Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Beginner" Cursor="Hand"
                                                Margin="0,0,8,0" AutomationProperties.Name="Beginner detail level">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="14,12">
                                                        <StackPanel>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE76E;" Foreground="{DynamicResource AccentBlueBrush}" /><Run Text="  Beginner" /></TextBlock>
                                                            <TextBlock Text="Plain-language verdicts and the essentials: status, Ready to play?, rated headline numbers, Game Monitor summary, tests and recordings." FontSize="12.5" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Trigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsBeginnerMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Advanced" Cursor="Hand"
                                                Margin="8,0,0,0" AutomationProperties.Name="Advanced detail level">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="14,12">
                                                        <StackPanel>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" Foreground="{DynamicResource AccentBlueBrush}" /><Run Text="  Advanced" /></TextBlock>
                                                            <TextBlock Text="Everything, plus per-server statistics, raw connection tables, route tracing, adapter details, HTTPS timings and the live probe log." FontSize="12.5" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Trigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsBeginnerMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Monitoring -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Monitoring" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="How often NetPulse tests your connection, and how much recent history the loss and variation numbers look at." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Test frequency" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Faster tests catch short problems but send more small probes. Once a second is light enough to leave running while you game." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ProbeIntervals}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ProbeIntervalMs, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Test frequency" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Recent window" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Probe loss and latency variation are measured over this much recent time, so they recover once a problem has passed." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecentWindows}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecentWindowSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="History used for your 'normal'" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Each target's usual latency is learned from this much history, so a far-away server is not flagged for being far away." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding HistoryWindows}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding HistoryWindowMinutes, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Alerts -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Desktop alerts" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="A Windows notification when the connection drops and when it comes back, when your router stops answering, when packets are being lost, or when Windows switches network. At most one of each kind every 3 minutes; latency spikes and Wi-Fi roaming stay in the timeline. Windows hides notifications while a full-screen game has focus if Do not disturb / game mode is on." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding DesktopAlerts, Mode=TwoWay}" Content="Show desktop alerts" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding AlertsOnlyInBackground, Mode=TwoWay}" IsEnabled="{Binding DesktopAlerts}" Content="Only while NetPulse is in the background" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Events -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Events" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="What gets written to the event timeline." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />

                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding NotifyOnLatencySpike, Mode=TwoWay}" Content="Record sudden latency spikes" />
                                    <Grid Margin="52,8,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="when ping jumps by at least" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding LatencySpikeText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="ms between two replies" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="10,0,0,0" />
                                    </Grid>

                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding NotifyOnPacketLoss, Mode=TwoWay}" Content="Record sustained probe loss" />
                                    <Grid Margin="52,8,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="when at least" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding PacketLossText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="% of recent probes get no reply" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Repeated events" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="A problem that keeps happening would otherwise fill the timeline." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DedupChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EventDedupSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Targets -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Reference servers" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Restore default servers" Command="{Binding ResetTargetsCommand}" Style="{StaticResource OutlineButton}" />
                                    </Grid>
                                    <TextBlock Text="NetPulse compares your router with several independent servers. Several of them degrading together is stronger evidence than one. These are not your game's servers." Style="{StaticResource CaptionText}" Margin="0,4,0,12" />

                                    <DataGrid ItemsSource="{Binding Targets}" SelectionMode="Single" IsReadOnly="False" MaxHeight="360" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="On" Width="60">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}" HorizontalAlignment="Left" Margin="4,0,0,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="Address" Binding="{Binding Host, Mode=OneWay}" IsReadOnly="True" Width="190" />
                                            <DataGridTextColumn Header="Method" Binding="{Binding Method, Mode=OneWay}" IsReadOnly="True" Width="150" />
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" IsReadOnly="True" Width="140" />
                                            <DataGridTemplateColumn Header="" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Remove" Style="{StaticResource OutlineButton}" Padding="10,3" MinHeight="28" FontSize="12.5"
                                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Add a server to monitor" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="A short name, for example 'My ISP DNS'" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="An IP address or host name, for example 9.9.9.9 or example.com" Margin="0,0,8,0" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding NewMethods}" SelectedIndex="{Binding NewMethodIndex, Mode=TwoWay}" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="3" Width="70" Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Port" Margin="0,0,8,0" Visibility="{Binding ShowPort, Converter={StaticResource BoolToVis}}" />
                                                <Button Grid.Column="4" Content="Add" Command="{Binding AddTargetCommand}" />
                                            </Grid>
                                            <TextBlock Text="Name, address, method (and port for TCP or HTTPS)." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding AddError}" Foreground="{DynamicResource AccentRedBrush}" FontSize="13" Margin="0,6,0,0"
                                                       Visibility="{Binding HasAddError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Recordings and Mark lag -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Recordings and Mark lag" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Mark lag without leaving your game, and decide how long recordings are kept on this PC." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Mark lag shortcut" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Works anywhere in Windows, also while a game has focus, whenever the Game Monitor or a network recording is running." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding MarkLagHotkey, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Mark lag shortcut" />
                                    </Grid>
                                    <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBlueHoverBrush}" Margin="0,0,0,12" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding MarkLagSound, Mode=TwoWay}" Content="Play a short sound when the shortcut marks lag" />
                                    <TextBlock Text="A different sound plays when nothing is being recorded, so you know the press was not stored." Style="{StaticResource CaptionText}" Margin="52,4,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Keep recordings" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Older recordings are deleted when NetPulse starts. Interrupted recordings are always kept." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RetentionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordingRetentionDays, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Keep recordings" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Window behaviour -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Windows" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="How NetPulse behaves on your desktop. The detail level (Beginner or Advanced) is switched at the top of the window." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Content="Minimise to the system tray instead of the taskbar" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Content="Keep running in the tray when the window is closed" Margin="0,12,0,0" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="Start NetPulse when I sign in to Windows" Margin="0,12,0,0" />
                                    <TextBlock Text="Exit completely from the tray icon's menu. Recordings in progress are saved when NetPulse exits." Style="{StaticResource CaptionText}" Margin="52,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Privacy and data -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Privacy and data" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding ProviderName, StringFormat='Speed test provider: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding ProviderDisclosure}" Style="{StaticResource CaptionText}" Margin="0,2,0,12" />
                                    <TextBlock Text="Where your data is kept" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DataFolder}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource AccentBlueHoverBrush}" Margin="0,2,0,2" />
                                    <TextBlock Text="Settings and recordings live here, never beside the program. NetPulse does not collect analytics or telemetry and never uploads a recording." Style="{StaticResource CaptionText}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource OutlineButton}" />
                                        <Button Content="Load default settings" Command="{Binding DefaultsCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save bar -->
                    <Border Grid.Row="1" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,4,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DirtyText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="13" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Discard changes" Command="{Binding RevertCommand}" Style="{StaticResource OutlineButton}" />
                                <Button Content="Save settings" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- ==================================================== -->
        <!-- Bottom Status Bar -->
        <!-- ==================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Monitoring" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding ProbeIntervalText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" />
                </StackPanel>

                <!-- what is being recorded right now, visible from every page -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsAnyRecording, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding FooterRecordingText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding FooterPrivacyText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding PrivacyFooter}" Cursor="Help"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="460" />
            </Grid>
        </Border>

    </Grid>
</Window>
