<Window x:Class="Lagwise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Lagwise.App.ViewModels"
        xmlns:controls="clr-namespace:Lagwise.App.Controls"
        xmlns:local="clr-namespace:Lagwise.App"
        mc:Ignorable="d"
        Title="Lagwise"
        Height="860" Width="1320" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- One integrated title bar instead of the Windows caption plus a second app bar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:UtcToLocalTimeConverter x:Key="LocalTime" />
        <local:EventLabelConverter x:Key="EventLabel" />
        <local:SeverityLabelConverter x:Key="SeverityLabel" />
        <local:SeverityBrushConverter x:Key="SeverityBrush" />
        <local:StringEqualsConverter x:Key="EqualsParam" />
        <local:ZeroToVisibleConverter x:Key="ZeroToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>

        <!-- One step of the "what Lagwise measures" chain on the Overview -->
        <Style x:Key="ChainNodeIcon" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="Background" Value="{DynamicResource BlueSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BlueEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChainConnector" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,22,0,0" />
        </Style>

        <!-- "Your results over time": bars for the latest results, the newest few as text, and what they add up to (TestPanel) -->
        <DataTemplate x:Key="TestPanelBody">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                           Visibility="{Binding HasAny, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Bars}" Visibility="{Binding HasAny, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Results chart">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,0" ToolTip="{Binding Tip}" Background="Transparent" MaxWidth="90">
                                <Grid Height="104">
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding ValueText}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" Margin="0,0,0,3" />
                                        <!-- a test is filled; ping seen in real use is drawn as an outline, because it was not a test -->
                                        <Grid Height="{Binding Height}">
                                            <Border x:Name="bar" CornerRadius="3,3,1,1" Opacity="{Binding Opacity}" Background="{DynamicResource AccentGreenBrush}" />
                                            <Border x:Name="edge" CornerRadius="3,3,1,1" BorderThickness="{Binding Edge}" BorderBrush="{DynamicResource AccentGreenBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Evening">
                                    <Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                    <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                    <Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentAmberBrush}" />
                                    <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource AccentAmberBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Bad">
                                    <Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentRedBrush}" />
                                    <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource AccentRedBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Recent}" Margin="0,14,0,0" AutomationProperties.Name="Recent results">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding When}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Main}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" />
                                    <TextBlock x:Name="detail" Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value=""><Setter TargetName="detail" Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- "Was it my connection?": a recording's verdict (VerdictViewModel), on the Game Monitor and in History -->
        <DataTemplate x:Key="VerdictBody">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:StatusMark Level="{Binding Level}" Width="36" Height="36" GlyphSize="16" VerticalAlignment="Top" Margin="0,1,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Headline}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding Headline, StringFormat='Verdict: {0}'}" />
                        <TextBlock Text="{Binding Summary}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Numbers}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Layers}" Margin="0,16,0,0" AutomationProperties.Name="Parts of the connection">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <controls:StatusMark Level="{Binding Level}" Width="16" Height="16" GlyphSize="8" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding Rating}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" FontSize="12.5" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="When it happened" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Episodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentAmberBrush}" VerticalAlignment="Center" Margin="2,0,9,0" />
                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MoreEpisodes}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasLagMarks, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Moments you marked as laggy" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding LagMarks}" AutomationProperties.Name="Lag marks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:StatusMark Level="{Binding Level}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,11,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                <Run Text="{Binding TimeText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Headline, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock x:Name="note" Text="{Binding Note}" FontSize="12.5" FontStyle="Italic" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Note}" Value=""><Setter TargetName="note" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"
                        Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentBlueHoverBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="What to do" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Advice}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="13" LineHeight="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,2" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ==================================================== -->
        <!-- Title bar (drag area, connection, mode, window buttons) -->
        <!-- ==================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <controls:LogoMark Width="26" Height="26" />
                    <TextBlock Text="Lagwise" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- Active connection -->
                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="32,0,0,0" Background="{DynamicResource BgCardBrush}" CornerRadius="15" Padding="12,5"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="The network adapter Windows is using now, and your router's address">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ActiveNic.Name, FallbackValue='Detecting...'}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding ActiveNic.SpeedDisplay, FallbackValue='', StringFormat='  ·  {0}'}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <TextBlock Text="  ·  Router " FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding ActiveNic.Ipv4Gateway, FallbackValue='searching'}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AccentBlueHoverBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <!-- Detail level + report -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Background="{DynamicResource BgInputBrush}" CornerRadius="9" Padding="3" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Beginner" ToolTip="Plain-language summaries and recommendations" Command="{Binding SetModeCommand}" CommandParameter="Beginner" Padding="12,4" FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBeginnerMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Advanced" ToolTip="Full statistics, protocols, routes and diagnostic evidence" Command="{Binding SetModeCommand}" CommandParameter="Advanced" Padding="12,4" FontSize="12.5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBeginnerMode}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleOverlayCommand}" Padding="8,4" MinHeight="32" Margin="0,0,2,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Mini overlay" ToolTip="Show or hide the mini overlay: live ping on top of other windows (works over games in windowed or borderless mode)">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding Appearance.ToggleThemeCommand}" Padding="8,4" MinHeight="32" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Switch theme" ToolTip="{Binding Appearance.ToggleTip}">
                        <TextBlock Text="{Binding Appearance.ToggleGlyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding ExportReportCommand}" Padding="12,4" MinHeight="32" FontSize="12.5"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Export diagnostic report" ToolTip="Save a readable report of the current state (Markdown)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Export report" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Window buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" Height="47" Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimise" ToolTip="Minimise" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Height="47" Click="MaximizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximise" ToolTip="Maximise" />
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Height="47" Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== -->
        <!-- Main Content Area with Navigation Sidebar -->
        <!-- ==================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16,12,12">
                <DockPanel>
                    <!-- Settings and Help share one row, so every page fits above them at the usual window height -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0,8,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <RadioButton Content="Settings" Tag="&#xE713;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                         IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Settings}"
                                         Command="{Binding SwitchTabCommand}" CommandParameter="Settings" />
                            <RadioButton Grid.Column="1" Tag="&#xE897;" GroupName="nav" Style="{StaticResource NavTabButton}" Margin="4,1,0,1"
                                         AutomationProperties.Name="Help &amp; glossary" ToolTip="Help &amp; glossary (F1)"
                                         IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Help}"
                                         Command="{Binding SwitchTabCommand}" CommandParameter="Help" />
                        </Grid>
                        <TextBlock Text="{Binding AppVersionText}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,6,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <TextBlock Text="MONITOR" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,2,0,4" />
                        <RadioButton Content="Overview" Tag="&#xE80F;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Dashboard}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Dashboard" />
                        <Grid>
                            <RadioButton Content="Game Monitor" Tag="&#xE7FC;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                         IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=GameMonitor}"
                                         Command="{Binding SwitchTabCommand}" CommandParameter="GameMonitor" />
                            <!-- recording indicator -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Pill}" Background="{DynamicResource RedSoftBrush}" BorderBrush="{DynamicResource RedEdgeBrush}"
                                    Padding="7,1,8,2" IsHitTestVisible="False" Visibility="{Binding GameMonitor.IsMonitoring, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="REC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentRedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <RadioButton Content="Network activity" Tag="&#xE968;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Activity}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Activity" />
                        <TextBlock Text="DIAGNOSE" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,14,0,4" />
                        <RadioButton Content="Targets &amp; probes" Tag="&#xEC05;" GroupName="nav" Style="{StaticResource NavTabButton}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Monitoring}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Monitoring" />
                        <RadioButton Content="Route trace" Tag="&#xE774;" GroupName="nav" Style="{StaticResource NavTabButton}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=RoutePath}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="RoutePath" />
                        <RadioButton Content="Bufferbloat test" Tag="&#xE9D2;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Bufferbloat}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Bufferbloat" />
                        <RadioButton Content="Speed test" Tag="&#xEC4A;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=SpeedTest}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="SpeedTest" />
                        <RadioButton Content="Site check" Tag="&#xEC27;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Sites}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Sites" />
                        <RadioButton Content="Security check" Tag="&#xEA18;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Security}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Security" />
                        <RadioButton Content="Adapter &amp; Wi-Fi" Tag="&#xE839;" GroupName="nav" Style="{StaticResource NavTabButton}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Adapter}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Adapter" />
                        <RadioButton Content="Probe log" Tag="&#xE9D9;" GroupName="nav" Style="{StaticResource NavTabButton}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=ProbeLog}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="ProbeLog" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SetModeCommand}" CommandParameter="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="16,7" Margin="0,2,0,0" Visibility="{Binding IsBeginnerMode, Converter={StaticResource BoolToVis}}"
                                ToolTip="Advanced adds Targets &amp; probes, Route trace, Adapter &amp; Wi-Fi and the live Probe log">
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE710;" /><Run Text="  4 more tools in Advanced" /></TextBlock>
                        </Button>
                        <TextBlock Text="RECORDS" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="16,14,0,4" />
                        <RadioButton Content="Event timeline" Tag="&#xE8FD;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Events}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Events" />
                        <RadioButton Content="Connection diary" Tag="&#xE787;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Diary}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Diary" />
                        <RadioButton Content="History &amp; reports" Tag="&#xE81C;" GroupName="nav" Style="{StaticResource NavTabButton}"
                                     IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=History}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="History" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Tab Content Switcher -->
            <Grid x:Name="PageHost" Grid.Column="1" Margin="32,26,32,22" MaxWidth="1440">

                <!-- TAB 1: OVERVIEW / DASHBOARD -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTab}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- One-time welcome: choose how much detail -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1.5"
                                Visibility="{Binding ShowModeChooser, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Welcome to Lagwise. How much detail do you want?" Style="{StaticResource CardTitle}" FontSize="17" />
                                <TextBlock Text="You can change this any time with the Beginner / Advanced switch at the top." Style="{StaticResource CardSubtitle}" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,12" TextWrapping="Wrap">
                                    <Run Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBlueHoverBrush}" /><Run Text="  When you play, Lagwise records your connection by itself and tells you afterwards whether lag came from your side. The Game Monitor page shows it, and turns it off." />
                                </TextBlock>
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding ChooseModeCommand}" CommandParameter="Beginner" Margin="0,0,8,0" Cursor="Hand" AutomationProperties.Name="Choose Beginner">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16,14">
                                                    <StackPanel>
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE76E;" Foreground="{DynamicResource AccentBlueBrush}" /><Run Text="  Beginner" /></TextBlock>
                                                        <TextBlock Text="Plain-language verdicts, the 'Ready to play?' checklist, the Game Monitor and your recordings. Just what you need to know if your connection is OK." FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Command="{Binding ChooseModeCommand}" CommandParameter="Advanced" Margin="8,0,0,0" Cursor="Hand" AutomationProperties.Name="Choose Advanced">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16,14">
                                                    <StackPanel>
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" Foreground="{DynamicResource AccentBlueBrush}" /><Run Text="  Advanced" /></TextBlock>
                                                        <TextBlock Text="Everything: per-server statistics and the evidence behind each verdict, route tracing, adapter details, HTTPS timings and a live log of every probe." FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- One-time offer for a downloaded copy: install it for this user -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1.5"
                                Visibility="{Binding ShowInstallOffer, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Install Lagwise offer">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Top" Margin="0,2,16,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Install Lagwise?" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding InstallOfferText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding InstallOfferError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentAmberBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding HasInstallOfferError, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Install" Command="{Binding InstallNowCommand}" AutomationProperties.Name="Install Lagwise now" />
                                    <Button Content="Not now" Command="{Binding InstallLaterCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" AutomationProperties.Name="Not now" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Status hero: tinted by the overall verdict -->
                        <Border CornerRadius="14" Padding="22,20" Margin="0,0,0,16" BorderThickness="1" Background="{Binding StatusSoftBrush}" BorderBrush="{Binding StatusEdgeBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="52" Height="52" CornerRadius="26" Background="{Binding StatusBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource IconFont}" FontSize="23" Foreground="{DynamicResource BgDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Connection status" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Background="Transparent" BorderBrush="{Binding StatusBrush}">
                                            <TextBlock Text="{Binding StatusCategory}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" TextWrapping="NoWrap" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusHeadline}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,4" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LikelyCause}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource ScrimBrush}" CornerRadius="10" Padding="16,12" VerticalAlignment="Center" Margin="20,0,0,0" MaxWidth="300">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE82F;" /><Run Text="  Recommended next step" /></TextBlock>
                                        <TextBlock Text="{Binding RecommendedAction}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Headline numbers -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <controls:StatTile Margin="0,0,8,0" Label="Reference ping" Glyph="&#xE774;" Unit="ms" Info="{Binding TipLatency}"
                                               Value="{Binding QuickInternetLatency, StringFormat={}{0:F1}}" Caption="Typical ping to public servers (not a game server)" Badge="{Binding PingBadge}" BadgeBrush="{Binding PingBadgeBrush}" BadgeLevel="{Binding PingBadgeLevel}" />
                            <controls:StatTile Margin="8,0,8,0" Label="Ping variation" Glyph="&#xE9D2;" Unit="ms" Info="{Binding TipVariation}" Accent="#A78BFA"
                                               Value="{Binding QuickJitter, StringFormat={}{0:F1}}" Caption="How much ping swings, last 60 s" Badge="{Binding JitterBadge}" BadgeBrush="{Binding JitterBadgeBrush}" BadgeLevel="{Binding JitterBadgeLevel}" />
                            <controls:StatTile Margin="8,0,8,0" Label="Probe loss" Glyph="&#xE8AB;" Unit="%" Info="{Binding TipLoss}" Accent="#F472B6"
                                               Value="{Binding QuickPacketLoss, StringFormat={}{0:F1}}" Caption="Test messages with no reply, last 60 s" Badge="{Binding LossBadge}" BadgeBrush="{Binding LossBadgeBrush}" BadgeLevel="{Binding LossBadgeLevel}" />
                            <controls:StatTile Margin="8,0,0,0" Label="Your router" Glyph="&#xE968;" Unit="ms" Info="{Binding TipRouter}" Accent="#2DD4BF"
                                               Value="{Binding QuickGatewayLatency, StringFormat={}{0:F1}}" Caption="This PC to your router (the first step)" Badge="{Binding RouterBadge}" BadgeBrush="{Binding RouterBadgeBrush}" BadgeLevel="{Binding RouterBadgeLevel}" />
                        </UniformGrid>

                        <!-- Ready to play? -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{Binding ReadinessBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding ReadinessGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource BgDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ready to play?" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding ReadinessHeadline}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding CopySummaryCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" MinHeight="32" FontSize="12.5" VerticalAlignment="Top" Margin="12,0,0,0"
                                            AutomationProperties.Name="Copy summary" ToolTip="Copy a short text snapshot of your connection (no IP addresses or network names) to paste into a chat or a support ticket. Ctrl+Shift+C">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding CopySummaryText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ReadinessItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{Binding Brush}" Margin="0,2,0,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Detail}" FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        <Button Content="Run the Bufferbloat test" Style="{StaticResource OutlineButton}" Padding="10,3" MinHeight="28" FontSize="12.5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                                Command="{Binding DataContext.OpenBufferbloatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Visibility="{Binding IsUntestedLoad, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ReadinessScope}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Last 24 hours, from the connection diary -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding Diary}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Last 24 hours" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Last24Text}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0" AutomationProperties.Name="Last 24 hours summary" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Padding="10,6"
                                            Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Diary" ToolTip="Open the connection diary (Ctrl+D)">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Open diary" /></StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Last24}" Margin="0,12,0,0" AutomationProperties.Name="Last 24 hours chart" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="24" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="cell" Height="16" Margin="1.5" CornerRadius="4" Background="{DynamicResource BgInputBrush}" Opacity="{Binding Opacity}" ToolTip="{Binding Tip}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Good"><Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentGreenBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fair"><Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentAmberBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Poor"><Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Thin">
                                                    <Setter TargetName="cell" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                                    <Setter TargetName="cell" Property="BorderThickness" Value="1.5" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="24 h ago" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="now" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Live graph of the last few minutes -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ping over time" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Your router and the public reference servers. Hover the graph to read exact values." Style="{StaticResource CardSubtitle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="170" ItemsSource="{Binding LiveWindows}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding LiveMinutes, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Graph time range" />
                                </Grid>
                                <controls:SessionChart Height="190" Data="{Binding LiveChart}" TargetOrder="{Binding LiveChartOrder}" AutomationProperties.Name="Live ping graph" />
                                <ItemsControl ItemsSource="{Binding LiveLegend}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Background="Transparent">
                                                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="8,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding LiveChartCaption}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Game + latest event: what is being watched and what happened last -->
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <Border CornerRadius="10" Background="{DynamicResource BlueSoftBrush}" />
                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding GameMonitor.HasCurrentIcon, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}" />
                                        <Image Source="{Binding GameMonitor.CurrentIcon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding GameMonitor.HasCurrentIcon, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Game Monitor" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding GameCardTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,2" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding GameCardDetail}" FontSize="13" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Content="Open Game Monitor" Command="{Binding SwitchTabCommand}" CommandParameter="GameMonitor" Style="{StaticResource OutlineButton}" Padding="12,5" MinHeight="32" FontSize="12.5" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AmberSoftBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentAmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Latest issue" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding LatestEventText}" FontSize="13.5" LineHeight="19" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,2" TextWrapping="Wrap" />
                                        <Button Content="Open event timeline" Command="{Binding SwitchTabCommand}" CommandParameter="Events" Style="{StaticResource OutlineButton}" Padding="12,5" MinHeight="32" FontSize="12.5" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- The measurement chain -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="What Lagwise measures, step by step" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Each step is a separate measurement. If the router is slow, the problem is in your home; if only the internet step is slow, it is further away. The internet step uses public reference servers, not your game's servers."
                                           Style="{StaticResource CardSubtitle}" Margin="0,3,0,18" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource ChainNodeIcon}"><TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="This PC" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding ActiveNic.Ipv4Address}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding AdapterStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Style="{StaticResource ChainConnector}">
                                        <Border Height="2" Background="{DynamicResource BorderStrongBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BgCardBrush}" HorizontalAlignment="Center" Padding="4,0">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource ChainNodeIcon}"><TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="Home router" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding ActiveNic.Ipv4Gateway}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding QuickGatewayLatency, StringFormat='{}{0:F1} ms'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <Grid Grid.Column="3" Style="{StaticResource ChainConnector}">
                                        <Border Height="2" Background="{DynamicResource BorderStrongBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BgCardBrush}" HorizontalAlignment="Center" Padding="4,0">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="4">
                                        <Border Style="{StaticResource ChainNodeIcon}"><TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="Internet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="Public reference servers" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Text="{Binding QuickInternetLatency, StringFormat='{}{0:F1} ms'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                    <Grid Grid.Column="5" Style="{StaticResource ChainConnector}">
                                        <Border Height="2" Background="{DynamicResource BorderStrongBrush}" CornerRadius="1" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BgCardBrush}" HorizontalAlignment="Center" Padding="4,0">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="6">
                                        <Border Style="{StaticResource ChainNodeIcon}"><TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="DNS lookups" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="Names into addresses" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Text="{Binding QuickDnsLatency, StringFormat='{}{0:F1} ms'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Advanced: every server at a glance -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Per-server statistics" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Now vs each server's own usual latency (learned over the history window), the 95th percentile, variation and loss in the recent window." Style="{StaticResource CardSubtitle}" />
                                <DataGrid ItemsSource="{Binding Targets}" IsReadOnly="True" MaxHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Server" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding TargetName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Now" Binding="{Binding LatencyDisplay}" Width="85" />
                                        <DataGridTextColumn Header="Usual" Binding="{Binding BaselineDisplay}" Width="95" />
                                        <DataGridTextColumn Header="P95" Binding="{Binding P95Display}" Width="85" />
                                        <DataGridTextColumn Header="Variation" Binding="{Binding JitterDisplay}" Width="85" />
                                        <DataGridTextColumn Header="Loss" Binding="{Binding LossDisplay}" Width="70" />
                                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Advanced mode: full diagnostic evidence -->
                        <Border Style="{StaticResource CardPanel}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Measured evidence behind the verdict" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding EvidenceSummary}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Beginner mode: short pointer instead of raw evidence -->
                        <controls:Callout Kind="Info" Visibility="{Binding IsBeginnerMode, Converter={StaticResource BoolToVis}}"
                                          Title="Want the numbers behind this verdict?" Text="Switch to Advanced (top right) for per-server statistics, the measured evidence, route tracing and a live log of every probe." />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: GAME MONITOR -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="GameMonitor">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel DataContext="{Binding GameMonitor}">
                        <controls:PageHeader Title="Game Monitor" Glyph="&#xE7FC;"
                                             Subtitle="Records how your connection behaves while you play, for any game, and tells you afterwards whether lag came from your side. Nothing leaves your PC." />

                        <!-- now: the game, what Lagwise is doing, and the controls -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="58" Height="58" VerticalAlignment="Top" Margin="0,0,16,0">
                                        <Border CornerRadius="14" Background="{DynamicResource BlueSoftBrush}" BorderBrush="{DynamicResource BlueEdgeBrush}" BorderThickness="1" />
                                        <Image Source="{Binding CurrentIcon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasCurrentIcon, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding CurrentMonogram}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBlueHoverBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasCurrentGame}" Value="True" />
                                                                <Condition Binding="{Binding HasCurrentIcon}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasCurrentGame, Converter={StaticResource InverseBoolToVis}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:StatusMark Level="{Binding StatusLevel}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <TextBlock Text="{Binding StatusTitle}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       AutomationProperties.Name="{Binding StatusTitle}" />
                                            <Border CornerRadius="9" Padding="8,2,9,3" Background="{DynamicResource RedSoftBrush}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Elapsed}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentRedBrush}" Typography.NumeralAlignment="Tabular"
                                                               AutomationProperties.Name="{Binding Elapsed, StringFormat='{}{0} RECORDING'}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusDetail}" FontSize="13.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" Margin="27,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Command="{Binding StartCommand}" Padding="16,8" MinHeight="40" AutomationProperties.Name="Record now"
                                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Record now" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding MarkLagCommand}" Style="{StaticResource OutlineButton}" Padding="14,8" MinHeight="40" AutomationProperties.Name="Mark lag"
                                                Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Mark lag" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Stop &amp; save" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Padding="14,8" MinHeight="40" Margin="8,0,0,0"
                                                Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Watch for" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" Width="340" MaxDropDownHeight="420"
                                                      AutomationProperties.Name="Watch for" VerticalAlignment="Center" Margin="0,0,10,6">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <Border CornerRadius="8" Background="{DynamicResource BlueSoftBrush}" />
                                                                <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock x:Name="mono" Text="{Binding Monogram}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBlueHoverBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                                <TextBlock x:Name="all" Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentBlueHoverBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter TargetName="mono" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAll}" Value="True">
                                                                <Setter TargetName="mono" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="all" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Command="{Binding AddGameCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Margin="0,0,4,6" AutomationProperties.Name="Add a game"
                                                    ToolTip="Choose a game's program (.exe) that Lagwise should watch for">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock Text="Add a game..." VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding RemoveGameCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Margin="0,0,4,6" AutomationProperties.Name="Take this game off the list"
                                                    ToolTip="Not a game, or not one to watch? Lagwise stops watching for it."
                                                    Visibility="{Binding SelectedGame.CanRemove, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock Text="Take off the list" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding GamesFoundText, Mode=OneWay}" />
                                            <Hyperlink Command="{Binding RefreshGamesCommand}" Foreground="{DynamicResource AccentBlueHoverBrush}"><Run Text="Look again" /></Hyperlink>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" Visibility="{Binding HasIgnoredGames, Converter={StaticResource BoolToVis}}">
                                            <Hyperlink Command="{Binding RestoreGamesCommand}" Foreground="{DynamicResource AccentBlueHoverBrush}"><Run Text="Show all games again" /></Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0" MaxWidth="330">
                                        <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoRecord, Mode=TwoWay}" Content="Record automatically" FontSize="14"
                                                  AutomationProperties.Name="Record automatically" Margin="0,18,0,0" />
                                        <TextBlock Text="Starts when a game starts, saves when it closes." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding MarkLagShortcutText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource MessageText}" Margin="0,10,0,0"
                                           Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVis}}" />
                                <Grid Margin="0,10,0,0" Visibility="{Binding HasSessionMessage, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SessionMessage}" Style="{StaticResource MessageText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Open this recording" Command="{Binding OpenRecordingCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" MinHeight="32" FontSize="12.5" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Margin="0,12,0,0" Visibility="{Binding HasStatusPage, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusPageText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding OpenStatusPageCommand}" Style="{StaticResource GhostButton}" Margin="12,0,0,0" AutomationProperties.Name="Open the official status page">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Official status page" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- your connection right now -->
                        <TextBlock Text="Your connection right now" Style="{StaticResource SectionLabel}" Margin="2,0,0,8" />
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <controls:StatTile Margin="0,0,8,12" Label="Router" Glyph="{Binding RouterGlyph}" Value="{Binding RouterPing}" Unit="ms" Caption="{Binding RouterCaption}"
                                               Badge="{Binding RouterBadge}" BadgeLevel="{Binding RouterLevel}" Info="How fast your own router answers. Slow or missing answers mean trouble between this PC and the router: Wi-Fi, the cable, or the router itself." />
                            <controls:StatTile Margin="8,0,8,12" Label="Internet" Glyph="&#xE774;" Value="{Binding InternetPing}" Unit="ms" Caption="{Binding InternetCaption}"
                                               Badge="{Binding InternetBadge}" BadgeLevel="{Binding InternetLevel}" Info="Ping to well-known internet servers (the middle one of them), judged against their own usual ping. Not the game's server." />
                            <controls:StatTile Margin="8,0,0,12" Label="Variation" Glyph="&#xE9D2;" Value="{Binding Jitter}" Unit="ms" Caption="between replies"
                                               Badge="{Binding JitterBadge}" BadgeLevel="{Binding JitterLevel}" Info="How much consecutive replies differ. Big swings feel like stutter even when the average ping is fine." />
                            <controls:StatTile Margin="0,0,8,0" Label="Lost" Glyph="&#xE7BA;" Value="{Binding Loss}" Unit="%" Caption="of recent probes"
                                               Badge="{Binding LossBadge}" BadgeLevel="{Binding LossLevel}" Info="Share of recent pings to the internet servers that got no answer." />
                            <controls:StatTile Margin="8,0,8,0" Label="This PC's traffic" Glyph="&#xE968;" Value="{Binding Traffic}" Unit="{Binding TrafficUnit}" Caption="{Binding TrafficCaption}"
                                               Badge="{Binding TrafficBadge}" BadgeLevel="{Binding TrafficLevel}" Info="Download or upload on this PC right now, whichever is higher. Heavy traffic (above the limit in Settings) competes with the game." />
                            <controls:StatTile Margin="8,0,0,0" Label="Processor" Glyph="&#xE950;" Value="{Binding Processor}" Unit="%" Caption="{Binding ProcessorCaption}"
                                               Badge="{Binding ProcessorBadge}" BadgeLevel="{Binding ProcessorLevel}" Info="How busy this PC's processor is, as Task Manager shows it. A PC working flat out stutters in a way that feels like lag." />
                        </UniformGrid>

                        <!-- the session being recorded, so far -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Visibility="{Binding HasSoFar, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="This session so far" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Worked out every few seconds from what Lagwise has measured since the recording started." Style="{StaticResource CardSubtitle}" Margin="0,3,0,16" />
                                <ContentPresenter Content="{Binding SoFar}" ContentTemplate="{StaticResource VerdictBody}" />
                            </StackPanel>
                        </Border>

                        <!-- the last game session -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Visibility="{Binding HasLastVerdict, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Your last game session: was it your connection?" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding LastVerdictTitle}" Style="{StaticResource CardSubtitle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Graph and full report" Command="{Binding OpenRecordingCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" MinHeight="32" FontSize="12.5" VerticalAlignment="Top" />
                                </Grid>
                                <ContentPresenter Content="{Binding LastVerdict}" ContentTemplate="{StaticResource VerdictBody}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasLastVerdict}" Value="False" />
                                                <Condition Binding="{Binding HasSoFar}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <controls:EmptyState Glyph="&#xE7FC;" Title="No game sessions yet"
                                                 Text="Play a game with automatic recording on, or press Record now. Afterwards Lagwise tells you here whether lag came from your Wi-Fi, your provider, this PC, or further away." />
                        </Border>

                        <!-- recent game sessions -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Visibility="{Binding HasRecentSessions, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recent game sessions" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="All recordings" Command="{Binding OpenHistoryCommand}" Style="{StaticResource GhostButton}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding RecentSessions}" AutomationProperties.Name="Recent game sessions">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    Cursor="Hand" AutomationProperties.Name="{Binding Title}" HorizontalContentAlignment="Stretch" Margin="0,0,0,2">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="row" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource BgSidebarBrush}" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border CornerRadius="8" Background="{DynamicResource BlueSoftBrush}" />
                                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Monogram}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   TextWrapping="NoWrap" Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        <TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                        <controls:StatusMark Level="{Binding Level}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                        <TextBlock Text="{Binding Headline}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <controls:Callout Kind="Info" Title="What Lagwise measures, and what it cannot"
                                          Text="Lagwise measures your side of the connection while you play: this PC, your Wi-Fi or cable and router, and your provider, against well-known internet servers. It cannot show the ping to the game's own server: games send the match over UDP, and Windows only lets programs with administrator rights see where that goes. When Lagwise says your side was fine but the game lagged, the cause was further away (the game's server or the route to it); the game's own ping display shows that part."
                                          Margin="0,0,0,16" />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: NETWORK ACTIVITY -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Activity}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="Activity">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel Margin="0,0,10,0">
                        <controls:PageHeader Title="Network activity" Glyph="&#xE968;"
                                             Subtitle="Everything this PC sends and receives on its network adapter, second by second, like the Performance tab of Task Manager. It includes games, downloads, updates and streaming; other devices at home are not included." />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Adapters}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedAdapterId, Mode=TwoWay}"
                                      Width="420" HorizontalAlignment="Left" AutomationProperties.Name="Network adapter" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <ComboBox Width="160" ItemsSource="{Binding Windows}" DisplayMemberPath="Label" SelectedValuePath="Seconds" SelectedValue="{Binding WindowSeconds, Mode=TwoWay}"
                                          AutomationProperties.Name="Time window" />
                                <Button Command="{Binding TogglePauseCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" Margin="8,0,0,0" MinWidth="92" AutomationProperties.Name="Pause graph"
                                        ToolTip="Freeze the graph and numbers for a closer look. Lagwise keeps measuring in the background.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Text" Value="&#xE768;" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PauseText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- live speeds and chart -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBlueBrush}" Opacity="0.18" />
                                        <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentBlueBrush}" Margin="-30,0,0,0" Width="30" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="Download" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding DownValue}" Style="{StaticResource BigNumber}" FontSize="40" Foreground="{DynamicResource AccentBlueBrush}" AutomationProperties.Name="Download now" />
                                        <TextBlock Text="{Binding DownUnit}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="6,0,0,8" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DownStats}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                                    <Grid Grid.Column="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentAmberBrush}" Opacity="0.18" />
                                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentAmberBrush}" Margin="-30,0,0,0" Width="30" TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="Upload" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding UpValue}" Style="{StaticResource BigNumber}" FontSize="40" Foreground="{DynamicResource AccentAmberBrush}" AutomationProperties.Name="Upload now" />
                                        <TextBlock Text="{Binding UpUnit}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="6,0,0,8" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding UpStats}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                                    </Grid>
                                </Grid>
                                <controls:ThroughputChart Height="280" Points="{Binding Points}" WindowSeconds="{Binding WindowSeconds}" Mirrored="{Binding Mirrored}" PingPoints="{Binding PingPoints}"
                                                          AutomationProperties.Name="Network activity graph" />
                                <Grid Margin="66,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Border Width="12" Height="4" CornerRadius="2" Background="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Download" Style="{StaticResource CaptionText}" Margin="6,0,18,0" />
                                        <Border Width="12" Height="4" CornerRadius="2" Background="{DynamicResource AccentAmberBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Upload" Style="{StaticResource CaptionText}" Margin="6,0,18,0" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowPing, Converter={StaticResource BoolToVis}}">
                                            <Border Width="12" Height="3" CornerRadius="1.5" Background="#F472B6" VerticalAlignment="Center" />
                                            <TextBlock Text="Reference ping (right axis)" Style="{StaticResource CaptionText}" Margin="6,0,18,0" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding ShowPing, Mode=TwoWay}" Content="Ping" FontSize="13"
                                                  ToolTip="Draw your reference ping over the traffic. If it climbs whenever a download runs, that is bufferbloat, happening live." />
                                        <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding Mirrored, Mode=TwoWay}" Content="Mirror" FontSize="13" Margin="16,0,0,0"
                                                  ToolTip="Download above the middle line, upload below, so they never hide each other." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- link use -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="How busy the link is" Style="{StaticResource CardTitle}" />
                                <ProgressBar Height="8" Value="{Binding Utilization, Mode=OneWay}" Maximum="1" Margin="0,12,0,8" />
                                <TextBlock Text="{Binding UtilizationText}" Style="{StaticResource CaptionText}" FontSize="13" />
                                <TextBlock Text="{Binding AdapterText}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- totals and counters -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <controls:StatTile Margin="0,0,8,0" Label="Received" Glyph="&#xE74B;" Value="{Binding ReceivedTotal}" Caption="{Binding TotalsCaption}" />
                            <controls:StatTile Margin="8,0,8,0" Label="Sent" Glyph="&#xE74A;" Value="{Binding SentTotal}" Caption="{Binding TotalsCaption}" Accent="#F59E0B" />
                            <controls:StatTile Margin="8,0,8,0" Label="Packets per second" Glyph="&#xE9D9;" Value="{Binding PacketsText}" Caption="{Binding PacketsCaption}" />
                            <controls:StatTile Margin="8,0,0,0" Label="Errors and drops" Glyph="&#xE7BA;" Value="{Binding ErrorsText}" Caption="{Binding ErrorsCaption}" />
                        </UniformGrid>

                        <!-- programs online -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Programs online now" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Programs on this PC with internet connections open, checked every few seconds. Windows reports which program owns each connection, but not how much data each one moves, so this shows who is talking to the internet, not exactly who is using the bandwidth. Programs that often download or upload a lot are marked." Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding Programs}" AutomationProperties.Name="Programs online">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Kind}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Connections}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding CanUseALot}" Value="True"><Setter TargetName="dot" Property="Fill" Value="{DynamicResource AccentAmberBrush}" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ProgramsSummary}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <controls:Callout Kind="Info" Title="Why this matters for games"
                                          Text="A game needs very little bandwidth (often well under 1 Mbps), but it needs it on time. A big download, a game update or a cloud backup on this PC fills the queue in your router and your game's packets wait behind it. When this PC moves more than the heavy-traffic limit in Settings (15 Mbps by default) for 10 seconds or longer, Lagwise notes it in the event timeline with the programs that were online. When it ends, the timeline says how much your ping rose meanwhile, a free bufferbloat check in real use (kept on the Bufferbloat page). Recordings keep every second of traffic, and History says for each moment you marked as laggy whether this PC was busy. Other devices at home do not show up here; the Bufferbloat test shows how your router copes with them." Margin="0,0,0,16" />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: TARGETS & MONITORING -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Monitoring">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:PageHeader Grid.Row="0" Title="Targets &amp; probes" Glyph="&#xEC05;"
                                         Subtitle="Your router and several independent public servers, tested about once a second. They judge your connection in general; they are not your game's servers." />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Targets}">
                        <DataGrid.Columns>
                            <!-- Target Name -->
                            <DataGridTemplateColumn Header="Target" Width="200" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" ToolTip="{Binding TargetName}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TargetHost}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Protocol -->
                            <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolText}" Width="72" />

                            <!-- Current RTT -->
                            <DataGridTemplateColumn Header="Latency" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LatencyDisplay}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Rolling Avg -->
                            <DataGridTextColumn Header="Usual" Binding="{Binding BaselineDisplay}" Width="76" />
                            <DataGridTextColumn Header="P95" Binding="{Binding P95Display}" Width="72" />

                            <!-- Min / Max -->
                            <DataGridTemplateColumn Header="Min / Max" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MinMaxDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Jitter -->
                            <DataGridTextColumn Header="Jitter" Binding="{Binding JitterDisplay}" Width="74" />

                            <!-- Packet Loss -->
                            <DataGridTextColumn Header="Loss, 60 s" Binding="{Binding LossDisplay}" Width="82" />

                            <!-- Sparkline Chart -->
                            <DataGridTemplateColumn Header="HTTPS timing" Width="2*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HttpsTimingDisplay}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   ToolTip="Where the last HTTPS probe's time went: name lookup, TCP connect, TLS handshake, first byte of the response" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="History" Width="*" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:SparklineChart Values="{Binding ChartValues}" LineBrush="{Binding StatusBrush}" Height="28" Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- TAB 3: ROUTE & MTR -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="RoutePath">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:PageHeader Grid.Row="0" Title="Route trace" Glyph="&#xE774;"
                                         Subtitle="Each device (hop) your data passes through. A slow or lossy hop only matters if the hops after it are slow too; many routers simply ignore probes." />

                    <!-- MTR Target Input Bar -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Trace to" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13.5" Margin="4,0,12,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding MtrDestination, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="An IP address or host name" AutomationProperties.Name="Trace destination" />

                            <Button Grid.Column="2" Content="Start trace" Command="{Binding StartMtrCommand}" Margin="10,0,6,0" />
                            <Button Grid.Column="3" Content="Stop" Style="{StaticResource OutlineButton}" Command="{Binding StopMtrCommand}" />

                            <TextBlock Grid.Column="4" Text="{Binding MtrStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13.5" />
                        </Grid>
                    </Border>

                    <!-- MTR Hops Table -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding MtrHops}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hop" Binding="{Binding HopNumber}" Width="50" />
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="140" />
                            <DataGridTextColumn Header="Hostname / rDNS" Binding="{Binding DisplayHost}" Width="200" />
                            <DataGridTextColumn Header="Now" Binding="{Binding CurrentRttMs, StringFormat='{}{0:F1} ms'}" Width="76" />
                            <DataGridTextColumn Header="Avg" Binding="{Binding AvgRttMs, StringFormat='{}{0:F1} ms'}" Width="76" />
                            <DataGridTextColumn Header="Best" Binding="{Binding MinRttMs, StringFormat='{}{0:F1} ms'}" Width="76" />
                            <DataGridTextColumn Header="Worst" Binding="{Binding MaxRttMs, StringFormat='{}{0:F1} ms'}" Width="76" />
                            <DataGridTextColumn Header="Loss" Binding="{Binding LossPercent, StringFormat='{}{0:F0}%'}" Width="60" />
                            <DataGridTextColumn Header="ASN / Organization" Binding="{Binding AsDisplay}" Width="160" />
                            <DataGridTemplateColumn Header="Diagnostics" Width="*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Sustained jump" Foreground="{DynamicResource AccentAmberBrush}" FontWeight="SemiBold"
                                                       >
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPersistentLatencyIncrease}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:EmptyState Grid.Row="2" Glyph="&#xE774;" Title="No trace yet" Text="Press Start trace to follow the path to the address above, hop by hop."
                                         Visibility="{Binding HasNoHops, Converter={StaticResource BoolToVis}}" />

                    <!-- Route Anomalies & Path Comparison -->
                    <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Route Anomalies -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="What stands out on this route" Style="{StaticResource CardTitle}" FontSize="15" Margin="0,0,0,8" />
                                <TextBlock Text="Run a trace: hops that add delay or lose probes, and whether that carries on to the destination, are listed here." Style="{StaticResource CaptionText}"
                                           Visibility="{Binding HasNoHops, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding RouteAnomalies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="16,0" />

                            <!-- Right: Path Comparison Tool -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Compare two destinations" Style="{StaticResource CardTitle}" FontSize="15" Margin="0,0,0,2" />
                                <TextBlock Text="Shows where the two paths split, which tells you how far a shared problem reaches." Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Text="{Binding PathCompareDestA}" Width="130" AutomationProperties.Name="First destination" />
                                    <TextBlock Text="vs" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0" />
                                    <TextBox Text="{Binding PathCompareDestB}" Width="130" AutomationProperties.Name="Second destination" />
                                    <Button Content="Compare" Command="{Binding ComparePathsCommand}" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding PathCompareSummary}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 4: BUFFERBLOAT TEST -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Bufferbloat">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <controls:PageHeader Title="Bufferbloat test" Glyph="&#xE9D2;"
                                             Subtitle="How much your ping rises while your connection is busy downloading or uploading. This is the lag you feel when someone else at home starts a big download." />
                        <controls:Callout Kind="Info" Title="{Binding TransferProviderTitle}" Text="{Binding TransferDisclosure}" Margin="0,0,0,16" />

                        <!-- Runner -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Three short phases, about 25 seconds" Style="{StaticResource CardTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Style="{StaticResource Pill}"><TextBlock Text="1  Ping at rest" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" /></Border>
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                            <Border Style="{StaticResource Pill}"><TextBlock Text="2  Ping while downloading" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" /></Border>
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                            <Border Style="{StaticResource Pill}"><TextBlock Text="3  Ping while uploading" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" /></Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding RunBufferbloatCommand}" Padding="16,8" AutomationProperties.Name="Start bufferbloat test">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Start test" /></StackPanel>
                                        </Button>
                                        <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelBufferbloatCommand}" Padding="16,8" Margin="8,0,0,0"
                                                Visibility="{Binding IsBufferbloatRunning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Height="6" Value="{Binding BufferbloatProgress}" Maximum="100" Margin="0,18,0,8" />
                                <Grid>
                                    <TextBlock Text="{Binding BufferbloatStatus}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding BufferbloatLiveText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"
                                               Visibility="{Binding IsBufferbloatRunning, Converter={StaticResource BoolToVis}}" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                                <controls:Callout Kind="Warning" Title="A recording is running" Margin="0,14,0,0"
                                                  Text="The test fills your connection on purpose, so the recording will show high ping while it runs. Stop the recording first, or keep that in mind when you read it."
                                                  Visibility="{Binding IsAnyRecording, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Result -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="150" Height="150" VerticalAlignment="Top">
                                    <controls:RingGauge Value="1" Maximum="1" Sweep="360" Thickness="10" Brush="{Binding GradeBrush}" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LatestBufferbloatResult.Grade, FallbackValue='?'}" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="SemiBold"
                                                   Foreground="{Binding GradeBrush}" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                                        <TextBlock Text="Grade" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                    <TextBlock Text="{Binding LatestBufferbloatResult.Summary, FallbackValue='No result yet'}" FontWeight="SemiBold" FontSize="18" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LatestBufferbloatResult.Explanation, FallbackValue='Run the test to see how much your ping rises under load. A small rise is normal; a big one means the router is queueing too much.'}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                    <UniformGrid Columns="3" Margin="0,18,0,14">
                                        <Border Background="{DynamicResource BgInputBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="At rest" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding LatestBufferbloatResult.BaselineLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='-'}" Style="{StaticResource BigNumber}" FontSize="22" Margin="0,4,0,0" />
                                                <TextBlock Text="baseline ping" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgInputBrush}" CornerRadius="10" Padding="14,12" Margin="6,0,6,0">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE896;" /><Run Text="  Downloading" /></TextBlock>
                                                <TextBlock Text="{Binding LatestBufferbloatResult.DownloadLoadedLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='-'}" Style="{StaticResource BigNumber}" FontSize="22" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding BufferbloatDownloadCaption}" FontSize="12" Foreground="{DynamicResource AccentAmberBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgInputBrush}" CornerRadius="10" Padding="14,12" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE898;" /><Run Text="  Uploading" /></TextBlock>
                                                <TextBlock Text="{Binding LatestBufferbloatResult.UploadLoadedLatencyMs, StringFormat='{}{0:F1} ms', FallbackValue='-'}" Style="{StaticResource BigNumber}" FontSize="22" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding BufferbloatUploadCaption}" FontSize="12" Foreground="{DynamicResource AccentAmberBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <controls:Callout Kind="Success" Title="Recommendation" Text="{Binding LatestBufferbloatResult.Recommendation}"
                                                      Visibility="{Binding HasBufferbloatResult, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Results over time (stored in test-history.json) -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding Results.Bufferbloat}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Your results over time" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Every finished test is kept on this PC, together with what Lagwise saw in real use: when this PC itself downloads or uploads a lot, the ping meanwhile shows whether your connection queues (outlined bars). Green is steady, amber a noticeable rise, red lag you will feel." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource OutlineButton}" Command="{Binding ClearCommand}" VerticalAlignment="Top" Margin="12,0,0,0"
                                            AutomationProperties.Name="Clear stored results" Visibility="{Binding HasAny, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Text="No results yet. Run the test, or simply keep Lagwise open: the next big download on this PC shows how your ping copes." Style="{StaticResource CaptionText}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TestPanelBody}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 5: SPEED TEST -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="SpeedTest">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <controls:PageHeader Title="Speed test" Glyph="&#xEC4A;"
                                             Subtitle="Download and upload throughput over several parallel streams. Speed matters for downloads and streaming; for games, steady ping matters far more." />
                        <controls:Callout Kind="Info" Title="{Binding TransferProviderTitle}" Text="{Binding TransferDisclosure}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="About 15 seconds of heavy traffic" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Run it once in a while, not continuously, and not while you are playing: it fills your connection on purpose." Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding RunSpeedTestCommand}" Padding="16,8" AutomationProperties.Name="Run speed test">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Run speed test" /></StackPanel>
                                        </Button>
                                        <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelSpeedTestCommand}" Padding="16,8" Margin="8,0,0,0"
                                                Visibility="{Binding IsSpeedTestRunning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Height="6" Value="{Binding SpeedTestProgress}" Maximum="100" Margin="0,18,0,8" Foreground="{DynamicResource AccentGreenBrush}" />
                                <TextBlock Text="{Binding SpeedTestStatus}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:Callout Kind="Warning" Title="A recording is running" Margin="0,14,0,0"
                                                  Text="The test fills your connection on purpose, so the recording will show high ping while it runs. Stop the recording first, or keep that in mind when you read it."
                                                  Visibility="{Binding IsAnyRecording, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0" Padding="20,22">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"><Run FontFamily="{StaticResource IconFont}" Text="&#xE896;" Foreground="{DynamicResource AccentGreenBrush}" /><Run Text="  Download" /></TextBlock>
                                    <Grid Width="210" Height="190" Margin="0,12,0,0">
                                        <controls:RingGauge Width="190" Height="190" Value="{Binding DownloadMbps}" Maximum="{Binding SpeedGaugeMax}" Thickness="12" Sweep="270" Brush="{DynamicResource AccentGreenBrush}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DownloadMbps, StringFormat={}{0:F1}}" Style="{StaticResource BigNumber}" FontSize="38" HorizontalAlignment="Center" />
                                            <TextBlock Text="Mbps" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding SpeedDownloadedText}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,-14,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0" Padding="20,22">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"><Run FontFamily="{StaticResource IconFont}" Text="&#xE898;" Foreground="{DynamicResource AccentBlueHoverBrush}" /><Run Text="  Upload" /></TextBlock>
                                    <Grid Width="210" Height="190" Margin="0,12,0,0">
                                        <controls:RingGauge Width="190" Height="190" Value="{Binding UploadMbps}" Maximum="{Binding SpeedGaugeMax}" Thickness="12" Sweep="270" Brush="{DynamicResource AccentBlueBrush}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding UploadMbps, StringFormat={}{0:F1}}" Style="{StaticResource BigNumber}" FontSize="38" HorizontalAlignment="Center" />
                                            <TextBlock Text="Mbps" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding SpeedUploadedText}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,-14,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding SpeedGaugeScale}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />

                        <!-- Results over time (stored in test-history.json) -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding Results.Speed}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Your results over time" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Every finished test is kept on this PC. Blue bars are evening tests (18:00 to midnight), when providers are busiest; green bars are other times. Comparing them, and Wi-Fi with a cable, shows whether a slowdown is at home or at your provider." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource OutlineButton}" Command="{Binding ClearCommand}" VerticalAlignment="Top" Margin="12,0,0,0"
                                            AutomationProperties.Name="Clear stored results" Visibility="{Binding HasAny, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Text="No results yet. Your finished tests are listed here, so you can compare evenings with daytime." Style="{StaticResource CaptionText}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TestPanelBody}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: SITE CHECK -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Sites">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel DataContext="{Binding SiteCheck}">
                        <controls:PageHeader Title="Site check" Glyph="&#xEC27;"
                                             Subtitle="Is a site down, or is something between you and it blocking it? Lagwise retraces what a browser does, one step at a time, and says where it stops." />
                        <controls:Callout Kind="Info" Title="What a check sends" Margin="0,0,0,16"
                                          Text="Each site is visited once from this PC as a browser would, without cookies or an account: a name lookup, a connection, a secure handshake and one request for its home page, plus its icon once a month. For comparison the name is also looked up with Cloudflare (1.1.1.1) and Google (8.8.8.8) public DNS over HTTPS, and a site's official status page is read when it has one. Nothing is sent unless you press Check or switch on the regular check. A bot check is never solved: it already proves the site answers." />

                        <!-- summary and actions -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Popular sites, and yours" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Summary}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Site check summary" />
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                        <Button Command="{Binding CheckAllCommand}" Padding="16,8" AutomationProperties.Name="Check all sites">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Check all" /></StackPanel>
                                        </Button>
                                        <Button Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}" Padding="16,8" Margin="8,0,0,0"
                                                Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoCheck, Mode=TwoWay}" Content="{Binding AutoCheckText}" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- the sites -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Sites}" AutomationProperties.Name="Sites" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Background="Transparent" Cursor="Hand">
                                                        <Grid.InputBindings>
                                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        </Grid.InputBindings>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- the site's own icon, or its letters until the icon is known -->
                                                        <Grid Width="34" Height="34">
                                                            <Border CornerRadius="9" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                                            <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding Monogram}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{Binding Host, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Category, Mode=OneWay}" /></TextBlock>
                                                        </StackPanel>
                                                        <Border x:Name="pill" Grid.Column="2" CornerRadius="13" Padding="5,3,11,3" Background="{DynamicResource BgInputBrush}" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <controls:StatusMark Level="{Binding Level}" Width="17" Height="17" />
                                                                <TextBlock Text="{Binding VerdictText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="7,0,0,0" TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding AnswerText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" ToolTip="Time until the site answered the request" />
                                                        <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" Padding="9,7" Margin="10,0,0,0"
                                                                Command="{Binding DataContext.CheckOneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                ToolTip="Check this site again" AutomationProperties.Name="{Binding Name, StringFormat='Check {0} again'}" />
                                                        <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" Padding="9,7" Margin="2,0,0,0"
                                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                ToolTip="Take this site off the list" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}" />
                                                        <TextBlock x:Name="chevron" Grid.Column="6" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="8,0,2,0" />
                                                    </Grid>
                                                    <!-- step by step -->
                                                    <StackPanel Margin="46,10,4,2" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Not checked yet. Press the circular arrow to check this site." Style="{StaticResource CaptionText}"
                                                                   Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVis}}" />
                                                        <TextBlock Text="{Binding Explanation}" FontSize="13.5" LineHeight="19" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,10,0,0" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="24" />
                                                                            <ColumnDefinition Width="170" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <controls:StatusMark Level="{Binding Level}" Width="15" Height="15" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <controls:Callout Kind="Info" Title="What you can do" Text="{Binding Advice}" Margin="0,8,0,0" Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding CheckedText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Good"><Setter TargetName="pill" Property="Background" Value="{DynamicResource GreenSoftBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fair"><Setter TargetName="pill" Property="Background" Value="{DynamicResource AmberSoftBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Poor">
                                                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource RedSoftBrush}" />
                                                    <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource RedEdgeBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Busy"><Setter TargetName="pill" Property="Background" Value="{DynamicResource BlueSoftBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter TargetName="chevron" Property="Text" Value="&#xE70E;" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- add a site -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewSite, UpdateSourceTrigger=PropertyChanged}" controls:Hint.Text="Add a site, e.g. example.com" AutomationProperties.Name="New site address">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Content="Add" Style="{StaticResource OutlineButton}" Command="{Binding AddCommand}" Margin="8,0,0,0" Padding="16,7" AutomationProperties.Name="Add site" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{Binding ShowHiddenText}" Command="{Binding ShowHiddenCommand}" HorizontalAlignment="Right"
                                            Visibility="{Binding HasHidden, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Text="{Binding AddError}" FontSize="12.5" Foreground="{DynamicResource AccentRedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasAddError, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <controls:Callout Kind="Info" Title="How Lagwise tells them apart" Margin="0,0,0,16"
                                          Text="Blocked by your DNS: your provider's (or router's) name lookup fails or points nowhere, while public DNS finds the site and it works. Blocked on the way: the connection is cut as soon as it names the site, or both the lookup and the connection are stopped. Intercepted: something answers with a certificate that is not the site's. From one PC, a site that is down and a site whose address is blocked look the same; the site's own status page, where it has one, tells them apart." />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: SECURITY CHECK -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Security">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel DataContext="{Binding Security}">
                        <controls:PageHeader Title="Security check" Glyph="&#xEA18;"
                                             Subtitle="Is this PC and its connection safe? What Windows reports about your firewall, network and Wi-Fi, and, when you press Check, whether your DNS and your secure connections can be trusted." />

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:StatusMark Level="{Binding Level}" Width="40" Height="40" GlyphSize="19" VerticalAlignment="Top" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                                   AutomationProperties.Name="Security verdict" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"><Run Text="{Binding CheckedText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ProgressText, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding CheckCommand}" Padding="16,8" VerticalAlignment="Top" Margin="16,0,0,0" AutomationProperties.Name="Run the security check">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Check" /></StackPanel>
                                    </Button>
                                </Grid>
                                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0" AutomationProperties.Name="Security items" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:StatusMark Level="{Binding Level}" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Detail}" FontSize="13.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="13" LineHeight="18" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                                                                   Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}"><Run Text="&#xEA80;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentAmberBrush}" /><Run Text="  " /><Run Text="{Binding Advice, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <controls:Callout Kind="Info" Title="What a check sends" Margin="0,0,0,16"
                                          Text="Opening this page sends nothing: the firewall, network type, Wi-Fi protection and the programs open to the network are read from Windows. Check also looks up one made-up name (with your DNS and with Cloudflare's public DNS), opens a secure connection to Google, Cloudflare and Wikipedia without sending anything over it, and asks your router once whether it offers UPnP. No administrator rights are needed and nothing is changed." />
                        <controls:Callout Kind="Info" Title="Lagwise's own safety" Margin="0,0,0,16"
                                          Text="Lagwise never asks for administrator rights, never captures your traffic, has no telemetry and no automatic updates, and keeps everything in %LOCALAPPDATA%\Lagwise. It starts Windows tools only by their full path and opens only web addresses in your browser. Exported reports leave out home-network and IPv6 addresses unless you choose otherwise. Each release lists the SHA-256 checksum of its download: compare it with Get-FileHash in PowerShell before running a copy you received from someone else." />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 6: ADAPTER & WI-FI -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Adapter">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <controls:PageHeader Title="Adapter &amp; Wi-Fi" Glyph="&#xE839;"
                                             Subtitle="The network adapter Windows is using right now: link, addresses, router and DNS servers, and Wi-Fi radio details when you are on Wi-Fi." />

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BlueSoftBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBlueHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveNic.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ActiveNic.Description}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="3" Text="To the internet" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding RouteText}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ThroughVpn}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentAmberBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Every ping then includes the VPN's detour, and slowness beyond your router may be the VPN's rather than your provider's. Lagwise still measures your own router directly."
                                                       Style="{StaticResource CaptionText}" Margin="0,4,0,0" Visibility="{Binding ThroughVpn, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="Type" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ActiveNic.InterfaceType}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="Link speed" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveNic.SpeedDisplay}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="Status" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource GreenSoftBrush}" BorderBrush="{DynamicResource GreenEdgeBrush}">
                                            <TextBlock Text="{Binding ActiveNic.OperationalStatus}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" TextWrapping="NoWrap" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Addresses and routing" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="IPv4 address" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ActiveNic.Ipv4Address}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="Subnet mask" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveNic.Ipv4Subnet}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Text="Router (gateway)" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveNic.Ipv4Gateway}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueHoverBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Text="DNS servers" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                                        <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ActiveNic.DnsServers}" Margin="0,7,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Wi-Fi -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,12"><Run FontFamily="{StaticResource IconFont}" Text="&#xE701;" Foreground="{DynamicResource AccentBlueHoverBrush}" /><Run Text="  Wi-Fi radio" /></TextBlock>
                                <TextBlock Text="{Binding NonWifiNote}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding ShowEthernetNote, Converter={StaticResource BoolToVis}}" />
                                <!-- Windows 11 24H2+: Wi-Fi details only for apps allowed to use location -->
                                <Grid Visibility="{Binding WifiNeedsLocation, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Windows keeps the Wi-Fi details to itself" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,16,0"
                                                   Text="Since Windows 11 24H2, the network name, signal strength and access point go only to apps allowed to use location, because Wi-Fi networks can reveal where you are. To see them here (and keep the Wi-Fi signal in recordings), turn on Location services and 'Let desktop apps access your location'. Lagwise never asks Windows where you are." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open location settings" Style="{StaticResource OutlineButton}" VerticalAlignment="Center"
                                            Command="{Binding OpenLocationSettingsCommand}" AutomationProperties.Name="Open Windows location settings" />
                                </Grid>
                                <UniformGrid Columns="4" Visibility="{Binding ShowWifiDetails, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Network name (SSID)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiSsid, FallbackValue='Not connected'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Signal strength" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiSignalPercent, StringFormat='{}{0}%', FallbackValue='N/A'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Wi-Fi standard" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiRadioType, FallbackValue='N/A'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Channel" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiChannel, FallbackValue='N/A', TargetNullValue='N/A'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,16,0,0">
                                        <TextBlock Text="Link rate (receive / send)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding WifiLinkRate}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,16,0,0">
                                        <TextBlock Text="Access point (BSSID)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiBssid, FallbackValue='N/A', TargetNullValue='N/A'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,16,0,0">
                                        <TextBlock Text="Protection" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveNic.WifiAuthentication, FallbackValue='N/A', TargetNullValue='N/A'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 7: EVENT TIMELINE -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Events">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:PageHeader Grid.Row="0" Title="Event timeline" Glyph="&#xE8FD;"
                                         Subtitle="What happened, newest first, in your local time. Repeated identical events are collapsed.">
                        <controls:PageHeader.Actions>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding ShowProblemsOnly, Mode=TwoWay}" Content="Problems only" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Content="Clear" Style="{StaticResource OutlineButton}" Command="{Binding ClearEventsCommand}" ToolTip="Clear the timeline (saved recordings keep their own events)" />
                            </StackPanel>
                        </controls:PageHeader.Actions>
                    </controls:PageHeader>

                    <DataGrid RowHeight="NaN" MinRowHeight="44" Grid.Row="1" ItemsSource="{Binding EventsView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, Converter={StaticResource LocalTime}}" Width="84" />
                            <DataGridTemplateColumn Header="Level" Width="104">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pill}" Padding="8,1,9,2" BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}" Background="Transparent">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityLabel}}" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="What happened" Binding="{Binding EventType, Converter={StaticResource EventLabel}}" Width="180" />
                            <DataGridTemplateColumn Header="Where" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding TargetName}" ToolTip="{Binding TargetName}" TextWrapping="Wrap" VerticalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Details" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4" LineHeight="18" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState Grid.Row="1" Glyph="&#xE8FD;" Title="Nothing to show yet" Text="{Binding NoEventsText}"
                                         Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- TAB: PROBE LOG (Advanced) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="ProbeLog">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:PageHeader Title="Probe log" Glyph="&#xE9D9;"
                                         Subtitle="Every measurement as it happens: which server, which method, the round-trip time or why there was no reply. The raw data behind every number in Lagwise." />

                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Width="260" ItemsSource="{Binding ProbeLogTargets}" SelectedItem="{Binding ProbeLogTarget, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Probe log server filter" />
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="{Binding ProbeLogFailuresOnly, Mode=TwoWay}" Content="No reply only" FontSize="13.5" Margin="18,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ProbeLogSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="18,0,12,0" />
                            <Button Grid.Column="3" Content="{Binding ProbeLogPauseText}" Command="{Binding ToggleProbeLogPauseCommand}" Style="{StaticResource OutlineButton}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding ProbeLog}" IsReadOnly="True" RowHeight="34" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="110" />
                            <DataGridTextColumn Header="Server" Binding="{Binding Target}" Width="220" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="140" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="80" />
                            <DataGridTemplateColumn Header="Result" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Result}" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState Grid.Row="2" Glyph="&#xE9D9;" Title="Waiting for probes" Text="Measurements appear here as they are made, about once a second per server."
                                         Visibility="{Binding ProbeLog.Count, Converter={StaticResource ZeroToVis}}" />
                </Grid>

                <!-- TAB: HELP & GLOSSARY -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Help">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <controls:PageHeader Title="Help &amp; glossary" Glyph="&#xE897;" Subtitle="What the words mean, and what Lagwise can and cannot tell you." />

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What Lagwise does, and does not, measure" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding HelpMeasuresText}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Beginner and Advanced" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run FontWeight="SemiBold" Text="Beginner" /><Run Text=" keeps to plain-language verdicts: the connection status, the 'Ready to play?' checklist, headline numbers with a one-word rating, the Game Monitor with its &quot;was it my connection?&quot; verdicts, Bufferbloat and Speed tests, the event timeline and your recordings." />
                                    <LineBreak /><LineBreak />
                                    <Run FontWeight="SemiBold" Text="Advanced" /><Run Text=" adds per-server statistics (usual latency, 95th percentile, variation), the measured evidence behind each verdict, route tracing, adapter and Wi-Fi details, HTTPS timing breakdowns, the live probe log, and how each glossary term is measured." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+1 … Ctrl+9, Ctrl+0" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Open the 1st … 10th page of the sidebar; Ctrl+H opens History, Ctrl+D the Connection diary, Ctrl+K the Site check" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Shift+C" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Copy a short summary of your connection" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="2" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+E" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Export a diagnostic report" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="3" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+Shift+O" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Show or hide the mini overlay" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="4" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+T" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Switch between light and dark" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="5" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="Ctrl+," FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Settings" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="6" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="F1" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="This page" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="7" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,3,12,3" HorizontalAlignment="Left"><TextBlock Text="{Binding MarkLagKeyText}" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" /></Border>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Mark lag while recording; works while a game has focus (change it in Settings)" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="On the taskbar and in the tray" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <TextBlock Style="{StaticResource CaptionText}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="21">
                                    <Run FontWeight="SemiBold" Text="Right-click Lagwise on the taskbar or in Start" /><Run Text=" for Mark lag, Start or stop a game recording, the mini overlay, the speed and bufferbloat tests and History. They work while Lagwise runs in the tray." /><LineBreak />
                                    <Run FontWeight="SemiBold" Text="Hover over the taskbar button" /><Run Text=" for two buttons under the preview: Mark lag, and Record or Stop." /><LineBreak />
                                    <Run FontWeight="SemiBold" Text="A dot on the taskbar button and the tray icon" /><Run Text=" shows the connection at a glance: amber when something is worth a look, red for a problem. While recording, the taskbar button shows a record dot. The bar on the button fills while a speed or bufferbloat test runs." /><LineBreak />
                                    <Run FontWeight="SemiBold" Text="Starting Lagwise again" /><Run Text=" brings the running Lagwise forward instead of opening a second one." /><LineBreak />
                                    <Run FontWeight="SemiBold" Text="Installing" /><Run Text=": the downloaded Lagwise runs as is. Settings &gt; Installation installs it for you (no administrator rights): it gets a Start menu entry and appears in Windows Settings &gt; Apps, where Uninstall removes it and keeps your settings and recordings." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Glossary" Style="{StaticResource CardTitle}" FontSize="18" Margin="2,8,0,10" />
                        <ItemsControl ItemsSource="{Binding Glossary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardPanel}" Margin="0,0,10,10" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Term}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AccentBlueHoverBrush}" />
                                            <TextBlock Text="{Binding Plain}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Switch to Advanced mode (top right) to also see how each value is measured." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding IsBeginnerMode, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: CONNECTION DIARY -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Diary">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel DataContext="{Binding Diary}">
                        <controls:PageHeader Title="Connection diary" Glyph="&#xE787;"
                                             Subtitle="How your connection did hour by hour, every day Lagwise was running, recording or not. Kept on this PC for 31 days. Reference servers only: not your game's server." />

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <controls:StatTile Margin="0,0,8,0" Label="Measured" Glyph="&#xE823;" Value="{Binding MeasuredText}" Caption="{Binding MeasuredCaption}" />
                            <controls:StatTile Margin="8,0,8,0" Label="Drops" Glyph="&#xF384;" Accent="#F87171" Value="{Binding DropsText}" Caption="{Binding DropsCaption}" />
                            <controls:StatTile Margin="8,0,8,0" Label="Probe loss" Glyph="&#xE8AB;" Accent="#F472B6" Value="{Binding LossText}" Caption="{Binding LossCaption}" />
                            <controls:StatTile Margin="8,0,0,0" Label="Worst hour" Glyph="&#xE9D2;" Accent="#A78BFA" Value="{Binding WorstText}" Caption="{Binding WorstCaption}" />
                        </UniformGrid>

                        <!-- hour by hour -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hour by hour" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MetricChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Metric, Mode=TwoWay}"
                                              Width="170" Margin="0,0,8,0" AutomationProperties.Name="Diary colours by" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding RangeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Days, Mode=TwoWay}"
                                              Width="150" AutomationProperties.Name="Diary range" />
                                </Grid>
                                <TextBlock Text="{Binding Summary}" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.Name="Diary summary" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding HourLabels}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="24" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,0,0,0" TextWrapping="NoWrap" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Connection diary chart" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="24" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="cell" Height="20" Margin="1.5" CornerRadius="4" Background="{DynamicResource BgInputBrush}" Opacity="{Binding Opacity}" ToolTip="{Binding Tip}" />
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Good"><Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentGreenBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Fair"><Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentAmberBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Poor"><Setter TargetName="cell" Property="Background" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Thin">
                                                                    <Setter TargetName="cell" Property="Background" Value="Transparent" />
                                                                    <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                                                    <Setter TargetName="cell" Property="BorderThickness" Value="1.5" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Future">
                                                                    <Setter TargetName="cell" Property="Background" Value="Transparent" />
                                                                    <Setter TargetName="cell" Property="ToolTip" Value="{x:Null}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- legend -->
                                <WrapPanel Margin="104,12,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AccentGreenBrush}" /><TextBlock Text="Good" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AccentAmberBrush}" /><TextBlock Text="Worth a look" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AccentRedBrush}" /><TextBlock Text="A drop, or lag you would feel" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="14" Height="14" CornerRadius="3" BorderBrush="{DynamicResource TextTertiaryBrush}" BorderThickness="1.5" /><TextBlock Text="Too little measured to rate" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource BgInputBrush}" /><TextBlock Text="Lagwise not running" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Fainter colours: only part of that hour was measured. Hover an hour for its numbers." Style="{StaticResource CaptionText}" Margin="104,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- drops -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Drops" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Every time the internet stopped answering while Lagwise was measuring, how long it lasted, and where the break was." Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                                <TextBlock Text="No drops in these days." Style="{StaticResource CaptionText}" Visibility="{Binding HasDrops, Converter={StaticResource InverseBoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Drops}" AutomationProperties.Name="Drops" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="250" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:StatusMark Level="Poor" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" />
                                                <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding Where}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MoreDropsText}" Style="{StaticResource CaptionText}" Visibility="{Binding HasMoreDrops, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <controls:Callout Kind="Info" Title="How the diary works" Margin="0,0,0,12"
                                          Text="Every second Lagwise runs, the plain-ping reference servers are measured anyway; the diary keeps what each hour added up to (stored in diary.json, about a few hundred kilobytes). Ping above usual compares each server with its own usual, so a far-away server never looks bad. A drop is counted when nothing on the internet answers for a few seconds; it says whether your router still answered (the break was at your modem or provider) or not (cable, Wi-Fi or the router). The exported report (Ctrl+E) includes the diary, as evidence for your provider." />
                        <Button Content="Clear the diary" Style="{StaticResource OutlineButton}" Command="{Binding ClearCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: HISTORY & REPORTS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="History">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel Margin="0,0,10,0">
                        <controls:PageHeader Title="History &amp; reports" Glyph="&#xE81C;"
                                             Subtitle="Everything you have recorded, kept on this PC. Open a recording to see its graph, what happened around the moments you marked as laggy, and export a report." />

                        <!-- Recordings list -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding History}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recordings" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" />
                                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" IsReadOnly="True" SelectionMode="Single" MaxHeight="260" MinHeight="64">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Recording" Width="*" MinWidth="140" SortMemberPath="Name">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Name}">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <!-- a recording that never got its normal stop (a crash, a power cut) -->
                                                            <TextBlock Text="Interrupted" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentAmberBrush}"
                                                                       Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVis}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartedText}" Width="140" />
                                            <DataGridTextColumn Header="Length" Binding="{Binding DurationText}" Width="98" />
                                            <DataGridTemplateColumn Header="Verdict" Width="172">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding VerdictText}">
                                                            <controls:StatusMark Level="{Binding VerdictLevel}" Width="15" Height="15" GlyphSize="8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding VerdictShort}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Lag marked" Binding="{Binding LagText}" Width="92" />
                                            <DataGridTextColumn Header="Probes" Binding="{Binding SamplesText}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" IsHitTestVisible="False"
                                                Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="No recordings yet" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Start one from the Game Monitor, or use 'Record a network session' below." Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBlueHoverBrush}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding StorageText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Time of day -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding History.Patterns}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="When is my connection worst?" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Every recording pooled by hour of the day. Each server is compared with its own usual ping, so the bars show extra delay and probe loss, not distance." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding ButtonText}" Command="{Binding AnalyzeCommand}" Style="{StaticResource OutlineButton}" VerticalAlignment="Top" Margin="12,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Bars}" Margin="0,10,0,0" Visibility="{Binding HasBars, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Time of day chart">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,0" ToolTip="{Binding Tip}" Background="Transparent">
                                                <Grid Height="84">
                                                    <Border x:Name="bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="3,3,1,1" Background="{DynamicResource AccentGreenBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentAmberBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Bad"><Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="None"><Setter TargetName="bar" Property="Background" Value="{DynamicResource BorderBrush}" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" Margin="0,12,0,0" AutomationProperties.Name="Time of day summary" />
                                <TextBlock Text="{Binding Progress}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Selected recording -->
                        <StackPanel DataContext="{Binding History}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="2,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DetailSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Export report" Command="{Binding ExportReportCommand}" />
                                    <Button Content="Export probe data (CSV)" Command="{Binding ExportSamplesCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardPanel}" Padding="14,12" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionText}" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Was it your connection? -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Was it your connection?" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Worked out by this version of Lagwise from the recording's own measurements: your router, internet servers and this PC." Style="{StaticResource CardSubtitle}" Margin="0,3,0,16" />
                                    <ContentPresenter Content="{Binding Verdict}" ContentTemplate="{StaticResource VerdictBody}" />
                                    <TextBlock Text="No lag marks in this recording. Press Mark lag (or its keyboard shortcut) while recording to flag a moment." Style="{StaticResource CaptionText}" Margin="0,14,0,0"
                                               Visibility="{Binding HasNoLagMarkers, Converter={StaticResource BoolToVis}}" />
                                    <controls:Callout Kind="Info" Title="Lag and this PC's own traffic" Text="{Binding LagTrafficSummary}" Margin="0,12,0,0"
                                                      Visibility="{Binding HasLagTrafficSummary, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding GameText}" Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                               Visibility="{Binding HasGameText, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <!-- Graph -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Graph" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Width="170" ItemsSource="{Binding ModeLabels}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" AutomationProperties.Name="Graph view" />
                                    </Grid>
                                    <controls:SessionChart Height="270" Data="{Binding Chart}" TargetOrder="{Binding ChartTargetOrder}" AutomationProperties.Name="Recording graph"
                                                           Visibility="{Binding IsLatencyMode, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}">
                                        <controls:ThroughputChart Height="270" Points="{Binding TrafficPoints}" WindowSeconds="{Binding TrafficWindowSeconds}" PingPoints="{Binding TrafficPings}"
                                                                  Markers="{Binding TrafficMarkers}" AutomationProperties.Name="Recording network activity graph" />
                                        <TextBlock Text="{Binding TrafficSummary}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Legend}" Margin="0,10,0,0" Visibility="{Binding IsLatencyMode, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,18,6" Background="Transparent">
                                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="8,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ChartCaption}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Per-target numbers -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Latency, variation and probe loss per target" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                    <TextBlock Text="Reference servers describe your connection in general; they are not the game's server." Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                                    <DataGrid ItemsSource="{Binding TargetStats}" IsReadOnly="True" MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Name}" Width="*" MinWidth="150" />
                                            <DataGridTextColumn Header="What it is" Binding="{Binding Kind}" Width="128" />
                                            <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="64" />
                                            <DataGridTextColumn Header="Median" Binding="{Binding Median}" Width="80" />
                                            <DataGridTextColumn Header="95th pct" Binding="{Binding P95}" Width="80" />
                                            <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="80" />
                                            <DataGridTextColumn Header="Variation" Binding="{Binding Variation}" Width="84" />
                                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="146" />
                                            <DataGridTextColumn Header="Probes" Binding="{Binding Probes}" Width="76" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Compare with another recording -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Visibility="{Binding CanCompare, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Compare with another recording" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="For questions like cable vs Wi-Fi, or evening vs morning. Lower is better for every number; changes within normal noise count as the same." Style="{StaticResource CardSubtitle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Choose a recording..." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" Margin="13,0,36,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" Panel.ZIndex="1" Visibility="{Binding HasCompareWith, Converter={StaticResource InverseBoolToVis}}" />
                                        <ComboBox Grid.Column="1" Width="300" ItemsSource="{Binding CompareChoices}" SelectedItem="{Binding CompareWith, Mode=TwoWay}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Compare with">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        <TextBlock Text="{Binding StartedText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource GhostButton}" Command="{Binding ClearCompareCommand}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasCompareWith, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding CompareSummary}" Style="{StaticResource MessageText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,10" />
                                    <DataGrid ItemsSource="{Binding CompareRows}" IsReadOnly="True" MaxHeight="300" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Typical ping, other" Binding="{Binding MedianA}" Width="135" />
                                            <DataGridTextColumn Header="this one" Binding="{Binding MedianB}" Width="90" />
                                            <DataGridTextColumn Header="Change" Binding="{Binding MedianChange}" Width="85" />
                                            <DataGridTextColumn Header="Variation, other" Binding="{Binding VariationA}" Width="115" />
                                            <DataGridTextColumn Header="this one" Binding="{Binding VariationB}" Width="90" />
                                            <DataGridTextColumn Header="Loss, other" Binding="{Binding LossA}" Width="90" />
                                            <DataGridTextColumn Header="this one" Binding="{Binding LossB}" Width="80" />
                                            <DataGridTemplateColumn Header="Overall" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Verdict}" Value="Better"><Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Verdict}" Value="Worse"><Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Events and notes -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Events" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                    <DataGrid RowHeight="NaN" MinRowHeight="40" ItemsSource="{Binding Events}" IsReadOnly="True" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, Converter={StaticResource LocalTime}}" Width="80" />
                                            <DataGridTextColumn Header="What happened" Binding="{Binding EventType, Converter={StaticResource EventLabel}}" Width="190" />
                                            <DataGridTemplateColumn Header="Where" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding TargetName}" ToolTip="{Binding TargetName}" TextWrapping="Wrap" VerticalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Details" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,3" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Recording controls -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Record a network session" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Records your connection's latency, variation, probe loss, events, monitoring gaps and the moments you mark as laggy. For a specific game, use the Game Monitor instead." Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Start recording" Command="{Binding StartSessionCommand}" />
                                    <Button Content="Stop &amp; save" Command="{Binding StopSessionCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    <Button Content="Mark lag" Command="{Binding MarkLagCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" ToolTip="Press when you notice lag so it can be compared with what was measured" />
                                </StackPanel>
                                <TextBlock Text="{Binding SessionStatus}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                <Button Content="Open this recording" Command="{Binding OpenLastRecordingCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" FontSize="12.5"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Live exports -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <Expander Header="Export what is on screen right now (not a recording)">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Snapshots of the current state: a readable report, the raw probe log from this run, or a machine-readable JSON file." Style="{StaticResource CaptionText}" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Diagnostic report (.md)" Command="{Binding ExportReportCommand}" />
                                        <Button Content="Probe log (.csv)" Command="{Binding ExportCsvCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                        <Button Content="Snapshot (.json)" Command="{Binding ExportJsonCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB: SETTINGS -->
                <Grid DataContext="{Binding Settings}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,12">
                            <controls:PageHeader Title="Settings" Glyph="&#xE713;" Subtitle="Appearance and Detail level apply as soon as you pick them. For everything else, a Save bar appears at the bottom once you change something. Settings stay on this PC." />

                            <!-- Appearance (applies immediately, outside the Save/Discard draft) -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" DataContext="{Binding DataContext.Appearance, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Changes here apply straight away." Style="{StaticResource CardSubtitle}" />

                                    <TextBlock Text="Theme" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Themes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        Margin="0,0,10,0" Cursor="Hand" AutomationProperties.Name="{Binding Label}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="14,12">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Accent colour" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Used for buttons, the selected page and highlights." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Accents}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Cursor="Hand" Margin="0,0,10,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid Width="34" Height="34">
                                                                    <Ellipse x:Name="ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Opacity="0" />
                                                                    <Ellipse Fill="{Binding Swatch}" Margin="5" />
                                                                    <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="ring" Property="Opacity" Value="1" />
                                                                        <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Interface size" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Makes all text and controls bigger or smaller, for high-resolution screens or across the room." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Scales}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UiScalePercent, Mode=TwoWay}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Interface size" />
                                    </Grid>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Mini overlay background" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="The overlay (button next to the theme switch, or the tray menu) stays on top of other windows. It shows over games running in windowed or borderless mode, not in exclusive fullscreen." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding OverlayOpacities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OverlayOpacityPercent, Mode=TwoWay}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Overlay background" />
                                    </Grid>
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding OverlayShowActivity, Mode=TwoWay}" Margin="0,14,0,0"
                                              Content="Show this PC's download and upload in the mini overlay" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding OverlayShowGraph, Mode=TwoWay}" Margin="0,10,0,0"
                                              Content="Show a graph of the last minute of ping in the mini overlay" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding OverlayClickThrough, Mode=TwoWay}" Margin="0,10,0,0"
                                              Content="Let clicks pass through the mini overlay to the game" />
                                    <TextBlock Text="The overlay then cannot be dragged or closed with the mouse: hide it with the title-bar button, the tray menu or Ctrl+Shift+O, and switch this off to move it. Clicking the overlay never takes the keyboard away from your game either way."
                                               Style="{StaticResource CaptionText}" Margin="46,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Detail level -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Detail level" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Also switchable with Beginner / Advanced at the top of the window. Applies straight away." Style="{StaticResource CardSubtitle}" />
                                    <UniformGrid Columns="2">
                                        <Button Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Beginner" Cursor="Hand"
                                                Margin="0,0,8,0" AutomationProperties.Name="Beginner detail level">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="14,12">
                                                        <StackPanel>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE76E;" Foreground="{DynamicResource AccentBlueBrush}" /><Run Text="  Beginner" /></TextBlock>
                                                            <TextBlock Text="Plain-language verdicts and the essentials: status, Ready to play?, rated headline numbers, Game Monitor summary, tests and recordings." FontSize="12.5" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Trigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsBeginnerMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Advanced" Cursor="Hand"
                                                Margin="8,0,0,0" AutomationProperties.Name="Advanced detail level">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="14,12">
                                                        <StackPanel>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" Foreground="{DynamicResource AccentBlueBrush}" /><Run Text="  Advanced" /></TextBlock>
                                                            <TextBlock Text="Everything, plus per-server statistics, raw connection tables, route tracing, adapter details, HTTPS timings and the live probe log." FontSize="12.5" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Trigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsBeginnerMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Monitoring -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Monitoring" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="How often Lagwise tests your connection, and how much recent history the loss and variation numbers look at." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Test frequency" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Faster tests catch short problems but send more small probes. Once a second is light enough to leave running while you game." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ProbeIntervals}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ProbeIntervalMs, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Test frequency" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Recent window" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Probe loss and latency variation are measured over this much recent time, so they recover once a problem has passed." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecentWindows}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecentWindowSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="History used for your 'normal'" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="The 95th percentile and typical latency on the Targets page cover this much history. 'Usual' is remembered for longer: once Lagwise has watched a server for about half an hour it uses the last ~8 hours of monitoring, kept across restarts, so a slow evening is not mistaken for normal." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding HistoryWindows}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding HistoryWindowMinutes, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Alerts -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Desktop alerts" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="A Windows notification when the connection drops and when it comes back, when your router stops answering, when packets are being lost, or when Windows switches network. At most one of each kind every 3 minutes; latency spikes and Wi-Fi roaming stay in the timeline. Windows hides notifications while a full-screen game has focus if Do not disturb / game mode is on." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding DesktopAlerts, Mode=TwoWay}" Content="Show desktop alerts" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding AlertsOnlyInBackground, Mode=TwoWay}" IsEnabled="{Binding DesktopAlerts}" Content="Only while Lagwise is in the background" Margin="0,10,0,0" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding GameStartCheck, Mode=TwoWay}" IsEnabled="{Binding DesktopAlerts}" Margin="0,10,0,0"
                                              Content="When your game starts, show whether the connection is ready to play" />
                                </StackPanel>
                            </Border>

                            <!-- Events -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Events" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="What gets written to the event timeline." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />

                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding NotifyOnLatencySpike, Mode=TwoWay}" Content="Record sudden latency spikes" />
                                    <Grid Margin="52,8,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="when ping jumps by at least" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding LatencySpikeText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="ms between two ping replies (HTTPS and DNS timings swing too much to count)" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0" />
                                    </Grid>

                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding NotifyOnPacketLoss, Mode=TwoWay}" Content="Record sustained probe loss" />
                                    <Grid Margin="52,8,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="when at least" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding PacketLossText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="% of recent probes get no reply" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Collapse repeated events" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="The same problem on the same server is written once, with a count, instead of filling the timeline." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DedupChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EventDedupSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Heavy traffic on this PC" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Note it in the timeline when this PC downloads or uploads faster than this for 10 seconds, with the programs that were online. Lagwise's own tests never count." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding HeavyTrafficChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding HeavyTrafficMbps, Mode=TwoWay}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Heavy traffic limit" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Targets -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Reference servers" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Restore default servers" Command="{Binding ResetTargetsCommand}" Style="{StaticResource OutlineButton}" />
                                    </Grid>
                                    <TextBlock Text="Lagwise compares your router with several independent servers. Several of them degrading together is stronger evidence than one. These are not your game's servers." Style="{StaticResource CaptionText}" Margin="0,4,0,12" />

                                    <DataGrid ItemsSource="{Binding Targets}" SelectionMode="Single" IsReadOnly="False" MaxHeight="360" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="On" Width="60">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}" HorizontalAlignment="Left" Margin="4,0,0,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="Address" Binding="{Binding Host, Mode=OneWay}" IsReadOnly="True" Width="190" />
                                            <DataGridTextColumn Header="Method" Binding="{Binding Method, Mode=OneWay}" IsReadOnly="True" Width="150" />
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" IsReadOnly="True" Width="140" />
                                            <DataGridTemplateColumn Header="" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Remove" Style="{StaticResource OutlineButton}" Padding="10,3" MinHeight="28" FontSize="12.5"
                                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Add a server to monitor" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="A short name, for example 'My ISP DNS'" Margin="0,0,8,0" controls:Hint.Text="Name, e.g. My ISP DNS" AutomationProperties.Name="New server name" />
                                                <TextBox Grid.Column="1" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="An IP address or host name, for example 9.9.9.9 or example.com" Margin="0,0,8,0" controls:Hint.Text="Address, e.g. 9.9.9.9 or example.com" AutomationProperties.Name="New server address" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding NewMethods}" SelectedIndex="{Binding NewMethodIndex, Mode=TwoWay}" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="3" Width="70" Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Port" Margin="0,0,8,0" Visibility="{Binding ShowPort, Converter={StaticResource BoolToVis}}" controls:Hint.Text="Port" AutomationProperties.Name="New server port" />
                                                <Button Grid.Column="4" Content="Add" Command="{Binding AddTargetCommand}" />
                                            </Grid>
                                            <TextBlock Text="Name, address, method (and port for TCP or HTTPS)." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding AddError}" Foreground="{DynamicResource AccentRedBrush}" FontSize="13" Margin="0,6,0,0"
                                                       Visibility="{Binding HasAddError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Recordings and Mark lag -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Recordings and Mark lag" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Mark lag without leaving your game, and decide how long recordings are kept on this PC." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Mark lag shortcut" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Works anywhere in Windows, also while a game has focus, whenever the Game Monitor or a network recording is running." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding HotkeyChoices}" SelectedItem="{Binding MarkLagHotkey, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Mark lag shortcut" />
                                    </Grid>
                                    <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBlueHoverBrush}" Margin="0,0,0,12" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding MarkLagSound, Mode=TwoWay}" Content="Play a short sound when the shortcut marks lag" />
                                    <TextBlock Text="A different sound plays when nothing is being recorded, so you know the press was not stored." Style="{StaticResource CaptionText}" Margin="52,4,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Keep recordings" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Older recordings are deleted when Lagwise starts. Interrupted recordings are always kept." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding RetentionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordingRetentionDays, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Keep recordings" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Keep automatic game recordings" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Recordings made by themselves when a game starts. Older ones go when a new one is saved; one in which you marked lag is always kept." Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AutoKeepChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AutoRecordingsKept, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Keep automatic game recordings" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Window behaviour -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Windows" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="How Lagwise behaves on your desktop. The detail level (Beginner or Advanced) is switched at the top of the window." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Content="Minimise to the system tray instead of the taskbar" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Content="Keep running in the tray when the window is closed" Margin="0,12,0,0" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="Start Lagwise when I sign in to Windows" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding StartupNote}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentAmberBrush}" Margin="52,4,0,0"
                                               Visibility="{Binding HasStartupNote, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Exit completely from the tray icon's menu. Recordings in progress are saved when Lagwise exits." Style="{StaticResource CaptionText}" Margin="52,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Installation: a downloaded copy installs itself for this user -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Visibility="{Binding ShowInstallCard, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Installation" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding InstallText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding InstallDesktopShortcut, Mode=TwoWay}" Content="Also put a shortcut on the desktop" Margin="0,0,0,12"
                                              Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}"
                                                Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Install Lagwise" />
                                        <Button Content="Open Settings &gt; Apps" Command="{Binding OpenAppsSettingsCommand}" Style="{StaticResource OutlineButton}"
                                                Visibility="{Binding ShowAppsButton, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding InstallMessage}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentAmberBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasInstallMessage, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <!-- Privacy and data -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Privacy and data" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding ProviderName, StringFormat='Speed test provider: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding ProviderDisclosure}" Style="{StaticResource CaptionText}" Margin="0,2,0,12" />
                                    <TextBlock Text="Where your data is kept" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DataFolder}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource AccentBlueHoverBrush}" Margin="0,2,0,2" />
                                    <TextBlock Text="Settings, recordings, test results, the connection diary and site icons live here, never beside the program. Lagwise does not collect analytics or telemetry and never uploads a recording." Style="{StaticResource CaptionText}" />
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding ReportsIncludeAddresses, Mode=TwoWay}" Margin="0,14,0,0"
                                              Content="Include home-network and IPv6 addresses in exported reports" />
                                    <TextBlock Text="Off: they read [hidden], so a report can be posted on a forum safely. Turn it on when your provider's support asks for them. Public servers and route hops are always shown." Style="{StaticResource CaptionText}" Margin="46,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource OutlineButton}" />
                                        <Button Content="Load default settings" Command="{Binding DefaultsCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save bar -->
                    <Border Grid.Row="1" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,4,10,0"
                            Visibility="{Binding ShowSaveBar, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DirtyText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="13" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Discard changes" Command="{Binding RevertCommand}" Style="{StaticResource OutlineButton}" />
                                <Button Content="Save settings" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- ==================================================== -->
        <!-- Bottom Status Bar -->
        <!-- ==================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Monitoring" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding ProbeIntervalText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" />
                </StackPanel>

                <!-- what is being recorded right now, visible from every page -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsAnyRecording, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding FooterRecordingText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding FooterPrivacyText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding PrivacyFooter}" Cursor="Help"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="460" />
            </Grid>
        </Border>

        <!-- Toast: results of exports and other actions, shown over the top of the content (the bottom has sticky bars, e.g. Settings) -->
        <Border Grid.Row="1" DataContext="{Binding Toast}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="232,14,0,0" Panel.ZIndex="50"
                MaxWidth="720" CornerRadius="10" Padding="16,10,8,10" BorderThickness="1" Background="{DynamicResource PopupBgBrush}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Notification" AutomationProperties.LiveSetting="Polite">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="{Binding Text}" />
                <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding ActionCommand}" Style="{StaticResource OutlineButton}" Padding="10,4" MinHeight="28" FontSize="12.5" Margin="14,0,0,0"
                        VerticalAlignment="Center" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="3" Content="&#xE711;" FontFamily="{StaticResource IconFont}" Command="{Binding CloseCommand}" Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="28" FontSize="11"
                        Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification" />
            </Grid>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentRedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

    </Grid>
</Window>
