<Window x:Class="Lagwise.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lagwise.App.Controls"
        Title="Lagwise overlay"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- A small always-on-top read-out for playing in windowed or borderless mode. Drag it anywhere; it remembers where. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="OverlayLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="OverlayValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <Grid Margin="6" MouseLeftButtonDown="Root_MouseLeftButtonDown" Cursor="SizeAll">
        <!-- background on its own layer so its opacity does not fade the text -->
        <Border x:Name="Backdrop" CornerRadius="12" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
        </Border>
        <StackPanel Margin="14,10,10,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:LogoMark Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lagwise" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <controls:StatusMark Level="{Binding ReadinessLevel}" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ReadinessHeadline}" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="9" Padding="7,1,8,2" Background="{DynamicResource RedSoftBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                        Visibility="{Binding IsAnyRecording, Converter={StaticResource BoolToVis}}" ToolTip="{Binding FooterRecordingText}">
                    <TextBlock Text="● REC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentRedBrush}" />
                </Border>
                <Button Grid.Column="3" Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Width="26" Height="22" FontSize="9" Click="Close_Click"
                        Cursor="Hand" ToolTip="Hide the overlay (show it again from the title bar or the tray)" AutomationProperties.Name="Hide overlay" />
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel ToolTip="Typical ping to public reference servers. Not your game's server.">
                    <TextBlock Text="Ref. ping" Style="{StaticResource OverlayLabel}" />
                    <TextBlock Style="{StaticResource OverlayValue}"><Run Text="{Binding QuickInternetLatency, StringFormat={}{0:F0}, Mode=OneWay}" /><Run Text=" ms" FontSize="11.5" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" ToolTip="How much the ping swings between replies (recent minute)">
                    <TextBlock Text="Variation" Style="{StaticResource OverlayLabel}" />
                    <TextBlock Style="{StaticResource OverlayValue}"><Run Text="{Binding QuickJitter, StringFormat={}{0:F1}, Mode=OneWay}" /><Run Text=" ms" FontSize="11.5" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" ToolTip="Test messages with no reply (recent minute)">
                    <TextBlock Text="Loss" Style="{StaticResource OverlayLabel}" />
                    <TextBlock Style="{StaticResource OverlayValue}"><Run Text="{Binding QuickPacketLoss, StringFormat={}{0:F1}, Mode=OneWay}" /><Run Text=" %" FontSize="11.5" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock>
                </StackPanel>
            </Grid>
            <controls:SparklineChart Values="{Binding OverlayPingHistory}" Height="30" Margin="0,8,0,0" LineBrush="{DynamicResource AccentBlueBrush}"
                                     Visibility="{Binding ShowOverlayGraph, Converter={StaticResource BoolToVis}}" ToolTip="Reference ping, the last minute" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding ShowOverlayTraffic, Converter={StaticResource BoolToVis}}"
                        ToolTip="Download and upload of this PC right now (Network activity page)">
                <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OverlayDown}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,14,0" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentAmberBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OverlayUp}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,0,0" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <TextBlock Text="{Binding OverlayHint}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
