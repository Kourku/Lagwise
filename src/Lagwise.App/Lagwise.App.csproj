<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Lagwise.Core\Lagwise.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 (Windows 10 2004): the Windows Runtime types the Store edition uses for its startup task -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 asks WinForms apps to set DPI awareness in code; this is a WPF app (WinForms only draws the tray menu), and WPF takes it from the manifest -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Lagwise</AssemblyName>
    <RootNamespace>Lagwise.App</RootNamespace>
    <Product>Lagwise Real-Time Network Quality &amp; Path Diagnostics</Product>
    <Description>Continuous real-time Internet connection health, latency, jitter, packet loss, bufferbloat, and hop-by-hop path diagnostic tool.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
